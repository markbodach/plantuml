'=================================================================
' THEME REGISTRY
'=================================================================
'
' Provides registration and invocation support for custom themes.
'
' Themes are processed in registration order.
'
' Example:
'
'   Register_Theme("ThemeA")
'   Register_Theme("PanelApp")
'
' Execution Order:
'
'   OntarioHealth
'       ↓
'   PanelApp
'
' Each registered theme may provide:
'
'   Preload_Theme_<Theme>()
'
'       Used for:
'           - Variables
'           - Theme initialization
'           - Configuration
'
'   Load_Lib_Styles_THEME_<Theme>()
'
'       Used for:
'           - Styles
'           - Stereotypes
'           - Formatting
'
'=================================================================
'
' REGISTRY
'
' Stores registered theme names using a delimiter-string
' registry implementation.
'
' Registry Format:
'
'   |ThemeA|
'
'   |ThemeA|ThemeB|
'
' Leading and trailing delimiters allow exact matching
' using %strpos() without partial-match collisions.
'
' Example:
'
'   |ThemeA|
'
'   |ThemeA|ThemeB|
'
'=================================================================

!$THEMES ?= "|"


!function $theme_registered($theme)

    !if ($theme == "")
        !return %false()
    !endif

    !return (%strpos($THEMES, "|" + $theme + "|") >= 0)

!endfunction


'=========================================================
' Is Theme Registered
'
' Performs an exact-match lookup against the delimiter-
' string registry using:
'
'   %strpos(
'       "|" + Theme + "|"
'   )
'
' This prevents partial-match collisions.
'
' Example:
'
'   Theme     ≠ ThemeExtended
'
'=========================================================

!function $Is_Theme_Registered($theme)
    !return $theme_registered($theme)
!endfunction


'=================================================================
' REGISTRATION
'=================================================================
' Adds a theme to the registry.
'
' Registration order is preserved.
'
' Duplicate registrations are ignored.
'
' Example:
'
'   Register_Theme("ThemeA")
'
' Registry:
'
'   |ThemeA|
'
'
'   Register_Theme("ThemeB")
'
' Registry:
'
'   |ThemeA|ThemeB|
'
'=================================================================
!procedure Register_Theme($theme)

    !if ($theme == "")
        !assert 0 == 1 : "MB_UML :: Registering Theme name cannot be blank"
    !endif

    !if ($theme_registered($theme) == %false())

        !$THEMES = $THEMES + $theme + "|"

    !endif

!endprocedure


'=================================================================
' REGISTRY PROCESSING
'=================================================================
'
' Themes are processed in registration order.
'
' Registry:
'
'   |ThemeA|ThemeB|
'
' Results In:
'
'   Preload_Theme_ThemeA()
'   Preload_Theme_ThemeB()
'
' Followed By:
'
'   Load_Lib_Styles_THEME_ThemeA()
'   Load_Lib_Styles_THEME_ThemeB()
'
' Iteration is implemented using:
'
'   !while
'   %substr()
'   %strpos()
'
' for maximum PlantUML compatibility.
'
'=================================================================

!procedure For_Each_Theme($prefix)

    !$remaining = $THEMES

    !while ($remaining != "|")

        !$remaining = %substr($remaining,1)

        !$pos = %strpos($remaining,"|")

        !$theme = %substr($remaining,0,$pos)

        !$remaining = "|" + %substr($remaining,$pos + 1)

        !if ($theme != "")

            !$proc = $prefix + $theme
            !log "Invoking Theme " + $prefix + "=[" + $theme + "]"
            %invoke_procedure($proc)

        !endif

    !endwhile

!endprocedure


'=================================================================
' PRELOAD INVOCATION
'=================================================================
'
' Themes are extracted one at a time from the registry:
'
'   |ThemeA|ThemeB|
'
'       ↓
'
'   ThemeA
'
'       ↓
'
'   ThemeB
'
' Iteration uses:
'
'   !while
'   %substr()
'   %strpos()
'
' to avoid dependency on !foreach support.
'
'=================================================================

!procedure Invoke_Preload_Themes()

    For_Each_Theme("Preload_Theme_")

!endprocedure


'=================================================================
' STYLE INVOCATION
'=================================================================
'
' Themes are extracted one at a time from the registry:
'
'   |ThemeA|ThemeB|
'
'       ↓
'
'   ThemeA
'
'       ↓
'
'   ThemeB
'
' Iteration uses:
'
'   !while
'   %substr()
'   %strpos()
'
' to avoid dependency on !foreach support.
'
'=================================================================

!procedure Invoke_Load_Themes()

    For_Each_Theme("Load_Lib_Styles_THEME_")

!endprocedure




