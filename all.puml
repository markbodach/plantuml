'=========================================================
' First Non-Blank Value
'
' Returns the first value that is not blank.
'
' Safe for:
'   - Undefined variables
'   - Empty strings
'   - Literal colors
'   - Semantic tokens
'
' Similar to:
'
'   value0 ?? value1 ?? value2 ...
'
'=========================================================
!function $first_defined_variable( $var0="", $var1="", $var2="", $var3="", $var4="", $var5="", $var6="", $var7="" )

    !$v = $UNSET
    !if ($var0 != "")
        !$v = $resolve_variable($var0,%false())
        !if ($variable_exists_safe($var0))
            !return $v
        !endif
    !endif

    !if ($var1 != "")
        !$v = $resolve_variable($var1,%false())
        !if ($variable_exists_safe($var1))
            !return $v
        !endif
    !endif

    !if ($var2 != "")
        !$v = $resolve_variable($var2,%false())
        !if ($variable_exists_safe($var2))
            !return $v
        !endif
    !endif

        !if ($var3 != "")
        !$v = $resolve_variable($var3,%false())
        !if ($variable_exists_safe($var3))
            !return $v
        !endif
    !endif

    !if ($var4 != "")
        !$v = $resolve_variable($var4,%false())
        !if ($variable_exists_safe($var4))
            !return $v
        !endif
    !endif

    !if ($var5 != "")
        !$v = $resolve_variable($var5,%false())
        !if ($variable_exists_safe($var5))
            !return $v
        !endif
    !endif

    !if ($var6 != "")
        !$v = $resolve_variable($var6,%false())
        !if ($variable_exists_safe($var6))
            !return $v
        !endif
    !endif

    !if ($var7 != "")
        !$v = $resolve_variable($var7,%false())
        !if ($variable_exists_safe($var7))
            !return $v
        !endif
    !endif


    

    ' repeat through var7...

    !return $UNSET

!endfunction
