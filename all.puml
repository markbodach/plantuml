!global $BREAKPOINTS_DEL = "|"
!global $BREAKPOINTS ?= "" + $BREAKPOINTS_DEL + ""
!global $REGISTRY_BREAKPOINTS = "BREAKPOINTS"

!procedure Enable_Breakpoint($name)
    Register_Lib_Object($name,$REGISTRY_BREAKPOINTS)
!endprocedure

!function $Breakpoint_Enabled($name)
    !return $object_registered($name,$REGISTRY_BREAKPOINTS)
!endfunction

!procedure Trigger_Breakpoint_Dump()
    !assert 0 == 1 : "MB_PUML :: <<BREAKPOINT>> Log Dump [" + $Registry_Get($REGISTRY_BREAKPOINTS) + "]"
!endprocedure

!procedure Trigger_Breakpoint($name, $message = "" )

    !if ( $Breakpoint_Enabled( $name ) )
        !assert 0 == 1 : "MB_PUML :: <<BREAKPOINT>> [" + $name + "] " + $message
    !endif

!endprocedure

!procedure Breakpoint_If( $name, $condition, $message = "" )

    !if ( $Breakpoint_Enabled($name))

        !if ($condition)
            Trigger_Breakpoint($name, $message)
        !endif

    !endif

!endprocedure

!procedure Disable_Breakpoint($name)

    Assert_Blank( $name, "Breakpoint name cannot be blank (p:Disable_Breakpoint)" )

    !if ($Breakpoint_Enabled($name))

        !$registry = $Registry_Get($REGISTRY_BREAKPOINTS)
        !$token = $BREAKPOINTS_DEL + $name + $BREAKPOINTS_DEL

        !$registry = $replace($registry, $token, $BREAKPOINTS_DEL)

        Registry_Set( $REGISTRY_BREAKPOINTS, $registry )

    !endif

!endprocedure

!procedure Disable_Breakpoint_If( $name, $condition)

    !if ($condition)
        Disable_Breakpoint($name)
    !endif

!endprocedure

!procedure Clear_Breakpoints()
    Registry_Set($REGISTRY_BREAKPOINTS, $BREAKPOINTS_DEL )
!endprocedure

!function $Breakpoint_Count()

    !$remaining = $Registry_Get( $REGISTRY_BREAKPOINTS )

    !$count = 0

    !while ($remaining != $BREAKPOINTS_DEL)

        !$remaining = %substr($remaining,1)
        !$pos = %strpos($remaining,$BREAKPOINTS_DEL)
        !$remaining = $BREAKPOINTS_DEL + %substr($remaining,$pos + 1)

        !$count = $count + 1

    !endwhile

    !return $count

!endfunction

!procedure Enable_Breakpoint_If($name, $condition)
    !if ($condition)
        Enable_Breakpoint($name)
    !endif

!endprocedure

!procedure Apply_If( $target, $source, $strictTarget = %false() )

    Assert_If( ($is_valid_variable_name($to_var_name($target)) == %false()), "Invalid target variable=[" + $target + "] (p:Apply_If)" )

    Assert_If( ($is_valid_variable_name($to_var_name($source)) == %false()), "Invalid source variable=[" + $source + "] (p:Apply_If)" )

    !if ($variable_exists_safe($source))

        !if ($strictTarget)

            Assert_If( ($variable_exists_safe($target) == %false()), "Target variable does not exist=[" + $target + "] (p:Apply_If)" )

        !endif

        !$sourceValue = %get_variable_value( $to_var_name($source) )

        Assert_Blank( $sourceValue, "Source variable is blank=[" + $source + "] (p:Apply_If)" )

        %set_variable_value( $to_var_name($target), $sourceValue )

    !endif

!endprocedure

!procedure Apply_If_Strict($target,$source)

    Apply_If( $target, $source, %true() )

!endprocedure

!procedure Inherit_If($target,$source)

    Assert_If( ($is_valid_variable_name($to_var_name($target)) == %false()), "Invalid target variable=[" + $target + "] (p:Inherit_If)" )

    Assert_If( ($is_valid_variable_name($to_var_name($source)) == %false()), "Invalid source variable=[" + $source + "] (p:Inherit_If)" )

    Assert_Variable_Exists( $source, "Inheritance source missing=[" + $source + "] (p:Inherit_If)" )

    !if ($variable_exists_safe($target) == %false())
        %set_variable_value( $to_var_name($target), %get_variable_value($to_var_name($source)) )
    !endif

!endprocedure

!function $Registry_Get($registryName)

    !$varName = "$" + $registryName

    Assert_If( (%variable_exists($varName) == %false()), "Registry variable not found=[" + $registryName + "] (f:Registry_Get)" )

    !return %get_variable_value($varName)

!endfunction

!procedure Registry_Set($registryName, $value)

    !$varName = "$" + $registryName

    %set_variable_value($varName, $value)

!endprocedure

!function $object_registered($name, $registryName)

    !if ($name == "")
        !return %false()
    !endif

    !$registry = $Registry_Get($registryName)

    !return (%strpos($registry, $REGISTRY_DEL + $name + $REGISTRY_DEL) >= 0)

!endfunction

!procedure Register_Lib_Object($name, $registryName)

    Assert_Blank( $name, "Registering type[" + $registryName + "] name cannot be blank (p:Register_Lib_Object)" )

    !if ($object_registered($name, $registryName) == %false())

        !$registry = $Registry_Get($registryName)

        !$registry = $registry + $name + $REGISTRY_DEL

        Registry_Set($registryName, $registry)

    !endif

!endprocedure

!procedure For_Each_Lib_Object($prefix, $registryName)

    !$remaining = $Registry_Get($registryName)

    !while ($remaining != $REGISTRY_DEL)

        !$remaining = %substr($remaining,1)

        !$pos = %strpos($remaining,$REGISTRY_DEL)

        !$name = %substr($remaining,0,$pos)

        !$remaining = $REGISTRY_DEL + %substr($remaining,$pos + 1)

        !if ($name != "")

            !$proc = $prefix + $name

            !log "[" + $registryName + "] " + $proc

            %invoke_procedure($proc)

        !endif

    !endwhile

!endprocedure

