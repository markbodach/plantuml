!procedure Trigger_Assert($message = "")
    !assert 0 == 1 : "MB_PUML :: <<ASSERT>> " + $message
!endprocedure

!procedure Assert_If($condition, $message = "")
    !if ($condition)
        Trigger_Assert($message)
    !endif
!endprocedure

!procedure Assert_Blank($value, $message = "")
    !if ($value == "")
        Trigger_Assert($message)
    !endif
!endprocedure

!procedure Assert_Not_Blank($value, $message = "")
    !if ($value != "")
        Trigger_Assert($message)
    !endif
!endprocedure

!procedure Assert_Variable_Exists($name, $message = "")
    !if ($variable_exists_safe($name) == %false())
        Trigger_Assert( $first_defined( $message, "Variable does not exist=[" + $name + "]" ) )
    !endif
!endprocedure

!procedure Assert_Variable_Missing($name, $message = "")
    !if ($variable_exists_safe($name))
        Trigger_Assert( $first_defined( $message, "Variable already exists=[" + $name + "]" ) )
    !endif
!endprocedure

!procedure Assert_Literal_Color($value, $message = "")
    !if ($is_literal_color($value) == %false())
        Trigger_Assert( $first_defined( $message, "Invalid literal color=[" + $value + "]" ) )
    !endif
!endprocedure

!procedure Assert_Hash_Token($value, $message = "")
    !if (%strpos(%upper($value), "#" ) == 0)
        Trigger_Assert( $first_defined( $message, "Hash token detected=[" + $value + "]" ) )
    !endif
!endprocedure

!procedure Trigger_Internal_Error($message="")
