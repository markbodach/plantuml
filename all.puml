'---------------------------------------------------------
' Variable Helpers
'---------------------------------------------------------

!function $has_dollar($name)
    !return (%strlen($name) > 0) && (%substr($name, 0, 1) == %chr(36))
!endfunction


!function $strip_dollar($name)

    !if ($has_dollar($name) == %false())
        !return $name
    !endif

    !$clean = %substr($name, 1)

    !if ($has_dollar($clean) == %true())
        !assert 0 == 1 : "MB_UML :: Variable name has multiple leading dollar signs=[" + $name + "]"
    !endif

    !return $clean

!endfunction


!function $to_var_name($name)
    !return %chr(36) + $strip_dollar($name)
!endfunction


!function $is_valid_variable_name($name)

    !if ($name == "")
        !return %false()
    !endif

    !if ($has_dollar($name) == %false())
        !return %false()
    !endif

    !$clean = $strip_dollar($name)

    !if $clean == ""
        !return %false()
    !endif

    !if ($clean != %upper($clean))
        !return %false()
    !endif

    !return %true()

!endfunction



!function $variable_exists_safe($name, $raise_error = %false())

    !$variable_name = $to_var_name($name)

    !if ($is_valid_variable_name($variable_name) == %false())

        !if ($raise_error == %true())
            !if ($variable_name != %upper($variable_name))
                !assert 0 == 1 : "MB_UML :: Variable names must be uppercase=[" + $variable_name + "]"
            !else
                !assert 0 == 1 : "MB_UML :: Invalid variable name=[" + $variable_name + "]"
            !endif
        !endif

        !return %false()

    !endif

    !return %variable_exists($variable_name)

!endfunction


'
' Resolves a dynamically named PlantUML variable.
'
' Accepted inputs:
'   COLOR_PRIMARY
'   $COLOR_PRIMARY
'
!function $resolve_variable($name, $raise_error = %true())

    !$variable_name = $to_var_name($name)
    !$value = ""

    !if ($variable_exists_safe($variable_name, $raise_error) == %false())

        !if ($raise_error == %true())
            !assert 0 == 1 : "MB_UML :: Invalid variable name or undefined variable=[" + $variable_name + "]"
        !endif

        !return ""

    !endif

    !$value = %get_variable_value($variable_name)

    !return $value

!endfunction
' --- End Import: src/libs/stdlib/components/_variables.puml ---


