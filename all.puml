'---------------------------------------------------------
' Normalize Lightness Ceiling
'
' Prevents a color from becoming lighter than the configured
' lightness ceiling.
'
' Behavior:
'   - Normalizes #RGB and #RRGGBBAA to #RRGGBB.
'   - Returns compliant colors unchanged.
'   - Darkens proportionally based on how far the color is
'     above the lightness ceiling.
'   - Avoids direct fractional RGB-channel scaling.
'   - Applies bounded follow-up corrections for rounding.
'
' Existing usage remains valid:
'
'   $normalize_lightness_ceiling("#D6EAF8")
'
'---------------------------------------------------------
!function $normalize_lightness_ceiling($hex, $lightness_ceiling = $LIGHTNESS_THRESHOLD, $minimum_darken_percent = 1)

    '
    ' Validate and normalize the input color.
    '
    $assert_literal_color($hex)

    !$color = $normalize_hex_rgb($hex)
    !$lightness = $hex_luminance($color)

    '
    ' Validate the lightness ceiling.
    '
    Assert_If( ($lightness_ceiling < 0) || ($lightness_ceiling > 255), "Lightness ceiling must be between 0 and 255=[" + $lightness_ceiling + "] (f:normalize_lightness_ceiling)" )


    '
    ' Validate the minimum correction.
    '
    Assert_If( ($minimum_darken_percent < 0) || ($minimum_darken_percent > 100), "Minimum darken percent must be between 0 and 100=[" + $minimum_darken_percent + "] (f:normalize_lightness_ceiling)" )


    '
    ' A color with zero calculated lightness cannot exceed
    ' a valid lightness ceiling.
    '
    !if ($lightness <= 0)
        !return %upper($color)
    !endif

    '
    ' The color already satisfies the lightness ceiling.
    '
    !if ($lightness <= $lightness_ceiling)
        !return %upper($color)
    !endif

    '
    ' Determine how far the color exceeds the ceiling.
    '
    !$overage = $lightness - $lightness_ceiling

    '
    ' Convert the overage into a proportional darkening
    ' percentage.
    '
    ' Example:
    '
    '   Lightness = 235
    '   Ceiling   = 223
    '   Overage   = 12
    '   Percent   = (12 * 100) / 235
    '
    !$darken_percent = %intval( ($overage * 100) / $lightness )

    '
    ' Apply the configured minimum correction.
    '
    !if ($darken_percent < $minimum_darken_percent)
        !$darken_percent = $minimum_darken_percent
    !endif

    '
    ' Protect the PlantUML darkening operation.
    '
    !if ($darken_percent > 100)
        !$darken_percent = 100
    !endif

    '
    ' Apply the initial proportional correction.
    '
    !$normalized = %darken($color, $darken_percent)

    !$normalized = $normalize_hex_rgb($normalized)
    !$normalized_lightness = $hex_luminance($normalized)

    '
    ' PlantUML color calculations and integer rounding may
    ' leave the result slightly above the lightness ceiling.
    '
    ' Apply bounded one-percent corrections until the color
    ' reaches the configured ceiling.
    '
    !$correction_count = 0
    !$maximum_corrections = 100

    !while ($normalized_lightness > $lightness_ceiling) && ($correction_count < $maximum_corrections)

        !$previous = $normalized

        !$normalized = %darken($normalized,1)

        !$normalized = $normalize_hex_rgb($normalized)

        '
        ' Stop if PlantUML no longer changes the color.
        '
        !if ($normalized == $previous)
            !$correction_count = $maximum_corrections
        !else
            !$normalized_lightness = $hex_luminance($normalized)
            !$correction_count = $correction_count + 1
        !endif

    !endwhile

    $assert_literal_color($normalized)

    !return %upper($normalized)

!endfunction

