'---------------------------------------------------------
' Normalize Darkness Floor
'
' Prevents a color from becoming darker than the configured
' darkness floor.
'
' Behavior:
'   - Normalizes #RGB and #RRGGBBAA to #RRGGBB.
'   - Returns compliant colors unchanged.
'   - Preserves existing zero-lightness safety behavior.
'   - Lightens proportionally based on how far the color is
'     below the darkness floor.
'   - Applies bounded follow-up corrections for rounding.
'
' Existing usage remains valid:
'
'   $normalize_darkness_floor("#050505")
'
'---------------------------------------------------------
!function $normalize_darkness_floor($hex, $darkness_floor = $DARKNESS_THRESHOLD, $minimum_lighten_percent = 1)

    '
    ' Validate and normalize the input color.
    '
    $assert_literal_color($hex)

    !$color = $normalize_hex_rgb($hex)
    !$darkness = $hex_luminance($color)

    '
    ' Validate the darkness floor.
    '
    Assert_If( ($darkness_floor < 0) || ($darkness_floor > 255), "Darkness floor must be between 0 and 255=[" + $darkness_floor + "] (f:normalize_darkness_floor)" )


    '
    ' Validate the minimum correction.
    '
    Assert_If( ($minimum_lighten_percent < 0) || ($minimum_lighten_percent > 100), "Minimum lighten percent must be between 0 and 100=[" + $minimum_lighten_percent + "] (f:normalize_darkness_floor)" )


    '
    ' Preserve the existing safety behavior for pure black
    ' or another color with zero calculated lightness.
    '
    !if ($darkness <= 0)
        !return %upper($color)
    !endif

    '
    ' The color already satisfies the darkness floor.
    '
    !if ($darkness >= $darkness_floor)
        !return %upper($color)
    !endif

    '
    ' Determine how far the color is below the floor.
    '
    !$shortfall = $darkness_floor - $darkness

    '
    ' Convert the shortfall into a proportional lightening
    ' percentage.
    '
    ' Multiplication occurs before division to avoid losing
    ' the fractional value through integer truncation.
    '
    !$lighten_percent = %intval( ($shortfall * 100) / $darkness_floor )

    '
    ' Apply the configured minimum correction.
    '
    !if ($lighten_percent < $minimum_lighten_percent)
        !$lighten_percent = $minimum_lighten_percent
    !endif

    '
    ' Protect the PlantUML lightening operation.
    '
    !if ($lighten_percent > 100)
        !$lighten_percent = 100
    !endif

    '
    ' Apply the initial proportional correction.
    '
    !$normalized = %lighten( $color, $lighten_percent )

    !$normalized = $normalize_hex_rgb($normalized)
    !$normalized_darkness = $hex_luminance($normalized)

    '
    ' PlantUML color calculations and integer rounding may
    ' leave the result slightly below the darkness floor.
    '
    ' Apply bounded one-percent corrections until the color
    ' reaches the configured floor.
    '
    !$correction_count = 0
    !$maximum_corrections = 100

    !while ($normalized_darkness < $darkness_floor) && ($correction_count < $maximum_corrections)

        !$previous = $normalized

        !$normalized = %lighten($normalized,1)

        !$normalized = $normalize_hex_rgb($normalized)

        '
        ' Stop if PlantUML no longer changes the color.
        '
        !if ($normalized == $previous)
            !$correction_count = $maximum_corrections
        !else
            !$normalized_darkness = $hex_luminance($normalized)
            !$correction_count = $correction_count + 1
        !endif

    !endwhile

    $assert_literal_color($normalized)

    !return %upper($normalized)

!endfunction





'---------------------------------------------------------
' Semantic Token Progression
'
' LIGHT -> BASE -> DARK -> DARKEST
'
' PRIMARY_LIGHT
'     -> PRIMARY
'
' PRIMARY
'     -> PRIMARY_DARK
'
' PRIMARY_DARK
'     -> PRIMARY_DARKEST
'
' PRIMARY_DARKEST
'     -> RGB darkening fallback
'---------------------------------------------------------

!function $get_darker_semantic_token($token)
  !$token = %upper($token)

  Breakpoint_If( "DARKER_TOKEN_LITERAL", $is_literal_color($token), "get_darker_semantic_token token=[" + $token + "]" )

  !if ($is_literal_color($token))
      !return ""
  !endif

  '
  ' PRIMARY_LIGHT -> PRIMARY
  '
  !if $ends_with($token, "_LIGHT")

    !$candidate = %substr( $token,0,%strlen($token)-6 )

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""
      !return $candidate
    !endif


  '
  ' PRIMARY_DARK -> PRIMARY_DARKEST
  '
  !elseif $ends_with($token, "_DARK")

    !$base = %substr( $token, 0, %strlen($token)-5 )
    !$candidate = $base + "_DARKEST"
    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif


  '
  ' PRIMARY_DARKEST
  ' No darker semantic promotion available
  '
  !elseif $ends_with($token, "_DARKEST")

    !return ""



  '
  ' PRIMARY -> PRIMARY_DARK
  '
  !else

    !$candidate = $token + "_DARK"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !endif

  !return ""

!endfunction


'---------------------------------------------------------
' Darken Resolver
'
' Resolution Order:
'
'   1. Semantic Promotion
'      LIGHT -> BASE
'      BASE -> DARK
'      DARK -> DARKEST
'
'   2. RGB Darken
'
'   3. Threshold Clamp
'---------------------------------------------------------
!function $darken_color($token, $darken_token = "DARKEN")

  Breakpoint_If( "DARKEN_MOTIVATION", %upper($token) == "#CCCCFF", "darken_color token=[" + $token + "] mode=[" + $darken_token + "]" )
  
  Assert_If( $is_special_style_token($token), "DARKEN cannot operate on special token=[" + $token + "] (f:darken_color)" )


  '
  ' Step 1:
  ' Semantic progression
  '
  !if (%upper($darken_token) == "DARKEN")

    !$darker = $get_darker_semantic_token($token)

    !if $darker != ""
        !return $get_semantic_color($darker)
    !endif

  !endif

  '
  ' Step 2:
  ' Resolve current value to a literal color
  '
  !$color = $resolve_literal_color($token)

  '
  ' Step 3:
  ' Determine darkening percentage
  '
  !$pct = $get_darken_percent($darken_token)

  '
  ' Step 4:
  ' RGB Darkening
  '
  !$dark = %darken($color, $pct)

  !if ($normalize_hex_rgb($color) == "#FFFFFF") && ($normalize_hex_rgb($dark) == "#FFFFFF")

      !$dark = %darken("#FEFEFE", $pct)

  !endif

  $assert_literal_color($dark)

  !$dark = $normalize_hex_rgb($dark)

  !return $normalize_darkness_floor($dark)

!endfunction
