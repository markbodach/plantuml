!function $strip_prefix($value, $prefix)

    !$prefixWithSeparator = $prefix + "_"

    !if %strpos($value, $prefixWithSeparator) == 0
        !return %substr( $value, %strlen($prefixWithSeparator) )
    !endif

    !return $value

!endfunction

!function $ends_with($value, $suffix)

  !$suffix_len = %strlen($suffix)
  !$value_len = %strlen($value)

  !if $value_len < $suffix_len
    !return %false()
  !endif

  !return %substr($value, $value_len - $suffix_len, $suffix_len) == $suffix

!endfunction

!function $ends_with_text($value)
  !return $ends_with($value, "_TEXT")

!endfunction

!function $is_special_style_token($token)
  !$tokenU = %upper($token)

  !if $tokenU == "AUTO" 
    !return %true()
  !elseif $tokenU == "CURRENT"
    !return %true()
  !elseif %strpos($tokenU,"DARKEN") == 0
    !return %true()
  !elseif %strpos($tokenU,"LIGHTEN") == 0
    !return %true()
  !endif

  !return %false()

!endfunction

!function $replace($text, $find, $replacement)

    !$result = ""
    !$remaining = $text

    !while (%strpos($remaining, $find) >= 0)

        !$pos = %strpos($remaining, $find)

        !$result = $result + %substr($remaining, 0, $pos)

        !$result = $result + $replacement

        !$remaining = %substr( $remaining, $pos + %strlen($find) )

    !endwhile

    !return $result + $remaining

!endfunction

!function $has_dollar($name)
    !return (%strlen($name) > 0) && (%substr($name, 0, 1) == %chr(36))
!endfunction

!function $strip_dollar($name)

    !if ($has_dollar($name) == %false())
        !return $name
    !endif

    !$clean = %substr($name, 1)

    Assert_If( ($has_dollar($clean)), "Variable name has multiple leading dollar signs=[" + $name + "] (f:strip_dollar)" )

    !return $clean

!endfunction

!function $to_var_name($name)
    !return %chr(36) + $strip_dollar($name)
!endfunction

!function $is_valid_variable_name($name)

    !if ($name == "")
        !return %false()
    !endif

    !if ($has_dollar($name) == %false())
        !return %false()
    !endif

    !$clean = $strip_dollar($name)

    !if $clean == ""
        !return %false()
    !endif

    !if ($clean != %upper($clean))
        !return %false()
    !endif

    !return %true()

!endfunction

!function $variable_exists_safe($name, $raise_error = %false(), $trace_error = "")

    !$variable_name = $to_var_name($name)

    !if ($is_valid_variable_name($variable_name) == %false())

        !if ($raise_error == %true())
            !if ($variable_name != %upper($variable_name))
                Trigger_Assert("Variable names must be uppercase=[" + $variable_name + "] (" + $trace_error + "f:variable_exists_safe)" )

            !else 
                Trigger_Assert( "Invalid variable name=[" + $variable_name + "] (" + $trace_error + "f:variable_exists_safe)" )
            !endif
        !endif

        !return %false()

    !endif

    !return %variable_exists($variable_name)

!endfunction

!function $resolve_variable($name, $raise_error = %true(), $trace_error = "")

    Assert_If( $is_literal_color($name), "Literal color passed where variable name expected=[" + $name + "] (" + $trace_error + "f:resolve_variable)" )

    !$variable_name = $to_var_name($name)
    !$value = ""

    !if ($variable_exists_safe($variable_name, $raise_error, $trace_error + "f:resolve_variable -> ") == %false())

        !if ($raise_error == %true())
            Trigger_Assert( "Invalid variable name or undefined variable=[" + $variable_name + ", " + $name + "] (" + $trace_error + "f:resolve_variable)" )
        !endif

        !return ""

    !endif

    !$value = %get_variable_value($variable_name)

    !return $value

!endfunction

