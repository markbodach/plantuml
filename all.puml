!function $repeat($text, $count)

    !$result = ""

    !while ($count > 0)

        !$result = $result + $text

        !$count = $count - 1

    !endwhile

    !return $result

!endfunction

!function $nl($count = 1)

    !return $repeat("\n", $count)

!endfunction

!function $pad_left($text, $count, $padding = " ")

    !return $repeat($padding, $count) + $text

!endfunction

!function $pad_right($text, $count, $padding = " ")

    !return $text + $repeat($padding, $count)

!endfunction

!function $pad_both($text, $count, $padding = " ")

    !$pad = $repeat($padding, $count)

    !return $pad + $text + $pad

!endfunction

!function $center_text($text, $width = 40, $padding = " " )

    !$length = %strlen($text)

    !if ($length >= $width)

        !return $text

    !endif

    !$left = %intval(($width - $length) / 2)

    !return $pad_left($text, $left, $padding )

!endfunction

!function $line_above($text, $count = 1)

    !return $nl($count) + $text

!endfunction

!function $line_below( $text, $count = 1 )

    !return $text + $nl($count)

!endfunction

!function $line_wrap( $text, $count = 1 )

    !$lines = $nl($count)

    !return $lines + $text + $lines

!endfunction

!function $surround( $text, $horizontal = 4, $vertical = 1, $padding = " " )

    !$body = $pad_both( $text, $horizontal, $padding )

    !$lines = $nl($vertical)

    !return $lines + $body + $lines

!endfunction

!function $framed_title( $text, $width = 60, $horizontal = 2, $vertical = 1 )

    !$centered = $center_text( $text, $width )

    !return $surround( $centered, $horizontal, $vertical )

!endfunction

!function $is_hex_digit($c)

  !$c = %upper($c)

  !if %strpos("0123456789ABCDEF", $c) != -1
    !return %true()
  !endif

  !return %false()

!endfunction

!function $is_literal_color($value)

    Trigger_Breakpoint("IS_LITERAL_COLOR", "value=[" + $value + "] len=[" + %strlen($value) + "]")

    !$value = %upper($value)
    !$POUNDlen = %strlen($POUND)
    !if (%substr($value,0,$POUNDlen) != $POUND )
        !return %false()
    !endif

    !$len = %strlen($value)

    !if ($len != 4) && ($len != 7) && ($len != 9)
        !return %false()
    !endif

    !$i = $POUNDlen

    !while ($i < $len)

        !if ($is_hex_digit(%substr($value,$i,1)) == %false())
            !return %false()
        !endif

        !$i = $i + 1

    !endwhile

    !return %true()

!endfunction

!function $normalize_hex_rgb($hex)

  Assert_Literal_Color($hex, "f.normalize_hex_rgb")
  !$len = %strlen($hex)

  !if ($len == 4)

    !$r = %substr($hex,1,1)
    !$g = %substr($hex,2,1)
    !$b = %substr($hex,3,1)

    !return $POUND + $r + $r + $g + $g + $b + $b

  !endif

  !if ($len == 9)

    !return $POUND + %substr($hex,1,6)

  !endif

  !return %upper($hex)

!endfunction

!function $hex_digit_value($c)

    !$c = %upper($c)

    !if ($c == "0")
        !return 0
    !elseif ($c == "1")
        !return 1
    !elseif ($c == "2")
        !return 2
    !elseif ($c == "3")
        !return 3
    !elseif ($c == "4")
        !return 4
    !elseif ($c == "5")
        !return 5
    !elseif ($c == "6")
        !return 6
    !elseif ($c == "7")
        !return 7
    !elseif ($c == "8")
        !return 8
    !elseif ($c == "9")
        !return 9
    !elseif ($c == "A")
        !return 10
    !elseif ($c == "B")
        !return 11
    !elseif ($c == "C")
        !return 12
    !elseif ($c == "D")
        !return 13
    !elseif ($c == "E")
        !return 14
    !elseif ($c == "F")
        !return 15
    !endif

    Trigger_Internal_Error( "Invalid hex digit=[" + $c + "]")

    !return -1
!endfunction

!function $int_to_hex_digit($n)

    Assert_If( ($n < 0) || ($n > 15), "Hex digit out of range=[" + $n + "]" )

    !if $n == 0
        !return "0"
    !elseif $n == 1
        !return "1"
    !elseif $n == 2
        !return "2"
    !elseif $n == 3
        !return "3"
    !elseif $n == 4
        !return "4"
    !elseif $n == 5
        !return "5"
    !elseif $n == 6
        !return "6"
    !elseif $n == 7
        !return "7"
    !elseif $n == 8
        !return "8"
    !elseif $n == 9
        !return "9"
    !elseif $n == 10
        !return "A"
    !elseif $n == 11
        !return "B"
    !elseif $n == 12
        !return "C"
    !elseif $n == 13
        !return "D"
    !elseif $n == 14
        !return "E"
    !else
        !return "F"
    !endif

!endfunction

!function $byte_to_hex($n)

    Assert_If( ($n < 0) || ($n > 255), "Hex digit out of range=[" + $n + "]")

    !$hi = %intval($n / 16)
    !$lo = $n - ($hi * 16)

    !return $int_to_hex_digit($hi) + $int_to_hex_digit($lo)

!endfunction

!function $hex_byte_to_int($hexByte)

  !if (%strlen($hexByte) != 2)
      Trigger_Internal_Error("Invalid hex byte=[" + $hexByte + "]" )
  !endif

  !$hi = $hex_digit_value(%substr($hexByte,0,1))
  !$lo = $hex_digit_value(%substr($hexByte,1,1))

  !return ($hi * 16) + $lo

!endfunction

!function $hex_red($hex)
  !$hex = $normalize_hex_rgb($hex)
  !return $hex_byte_to_int( %substr($hex,1,2) )

!endfunction

!function $hex_green($hex)
  !$hex = $normalize_hex_rgb($hex)
  !return $hex_byte_to_int( %substr($hex,3,2))
!endfunction

!function $hex_blue($hex)
  !$hex = $normalize_hex_rgb($hex)
  !return $hex_byte_to_int(%substr($hex,5,2) )

!endfunction

!function $rgb_luminance($r,$g,$b)
  !return ( ((299 * $r) + (587 * $g) + (114 * $b)) / 1000)
!endfunction

!function $hex_luminance($hex)

  !$r = $hex_red($hex)
  !$g = $hex_green($hex)
  !$b = $hex_blue($hex)

  !return $rgb_luminance($r, $g, $b )

!endfunction

!function $rgb_to_hex($r,$g,$b)
  !return $POUND + $byte_to_hex($r) + $byte_to_hex($g) + $byte_to_hex($b)

!endfunction

!function $get_text_color( $bg_var_name, $dark_text_var_name="COLOR_TEXT", $light_text_var_name="COLOR_TEXT_LIGHT" )
  
  !return $get_variable_text_color($bg_var_name, $dark_text_var_name, $light_text_var_name )

!endfunction

!function $normalize_color_name($name)
  !$clean = %upper($strip_dollar($name))
  !if %substr($clean, 0, 6) == "COLOR_"
    !return %substr($clean, 6)
  !endif
  !return $clean
!endfunction

!function $semantic_color_variable( $name, $raise_error = %false(), $trace_error = "" )

  Breakpoint_If( "MOTIVATION_HASH_TOKEN", %strpos(%upper($name), "#MOTIVATION") >= 0, "name=[" + $name + "]" )

  Breakpoint_If( "SEMANTIC_COLOR_VARIABLE_LITERAL", $is_literal_color($name), "semantic_color_variable literal=[" + $name + "] trace=[" + $trace_error + "]" )
  
  !if ($is_literal_color($name))
      !return %upper($name)
  !endif

  !$normalized = $normalize_color_name($name)

  !if ($variable_exists_safe($normalized))
      !return $normalized
  !endif

  !$candidate = "COLOR_" + $normalized

  !if ($variable_exists_safe($candidate))
      !return $candidate
  !endif

  !if ($raise_error == %true() )

    Trigger_Assert( "Semantic color variable not found. " + "input=[" + $name + "] " + "normalized=[" + $normalized + "] " + "candidate=[" + $candidate + "] " + "(" + $trace_error + "f:semantic_color_variable)" )

  !endif

  !return ""

!endfunction

!function $get_semantic_text_color( $semantic_suffix, $dark_text_var_name="COLOR_TEXT", $light_text_var_name="COLOR_TEXT_LIGHT")
  
  !$semantic_color = $semantic_color_variable( $semantic_suffix, %true(), "f:get_semantic_text_color" )
  !return $get_text_color( $semantic_color, $dark_text_var_name, $light_text_var_name )

!endfunction

!function $get_color($value)

  Assert_Blank($value, "get_color() received blank value (f:get_color)" )

  !if ($is_literal_color($value))
      !return %upper($value)
  !endif

  !$resolved = $resolve_variable($value, %false(), "f:get_color ->")

  !if $resolved != ""
      !return $resolved
  !endif

  !return $value

!endfunction

!function $get_semantic_color($semantic_suffix, $raise_error=%false(), $trace_error="")

  Breakpoint_If( "HASH_TOKEN_TRACE", (%strpos(%upper($semantic_suffix), $POUND ) == 0), "semantic_suffix=[" + $semantic_suffix + "] trace=[" + $trace_error + "]" )

  Assert_Hash_Token( $semantic_suffix, "Hash Token Detected=[" + $semantic_suffix + "] trace=[" + $trace_error + "] (f:get_semantic_color)" )

  Assert_Blank( $semantic_suffix, "Function received blank semantic suffix (f:get_semantic_color)" )

  Breakpoint_If( "SEMANTIC_COLOR_LITERAL", $is_literal_color($semantic_suffix), "(f:get_semantic_color." + $trace_error + ") received literal color=[" + $semantic_suffix + "]" )
  
  !if $is_special_style_token($semantic_suffix)
      !return $semantic_suffix
  !endif

  !$candidate = $semantic_color_variable($semantic_suffix, %true(), "f:get_semantic_color")

  Assert_If( ($candidate == "COLOR_"), "Invalid semantic token=[" + $semantic_suffix + "] (f:get_semantic_color." + $trace_error + ")" )

  !return $get_color($candidate)

!endfunction

!function $needs_light_text($hex)
  !$lum = $hex_luminance($hex)
  !return ($lum <= $CONTRAST_THRESHOLD)
!endfunction

!function $get_contrast_text_color($backgroundColor, $darkTextColor="#000000", $lightTextColor="#FFFFFF" )

    !if ($needs_light_text($backgroundColor))
        !return $lightTextColor
    !endif

    !return $darkTextColor

!endfunction

!function $get_auto_text_color($background, $dark_text_var_name="COLOR_TEXT", $light_text_var_name="COLOR_TEXT_LIGHT")

  !if ($is_literal_color($background))
    !$dark = $resolve_variable($dark_text_var_name, %true(), "f:get_auto_text_color -> ")
    !$light = $resolve_variable($light_text_var_name, %true(), "f:get_auto_text_color -> ")

    !return $get_contrast_text_color($background, $dark, $light)

  !endif

  !return $get_semantic_text_color( $background, $dark_text_var_name, $light_text_var_name )

!endfunction

!function $get_variable_text_color($bg_var_name, $dark_text_var_name="COLOR_TEXT", $light_text_var_name="COLOR_TEXT_LIGHT" )

  !if ($is_literal_color($bg_var_name)) 
    !$bg_val = %upper($bg_var_name) 
  !else 
    !$bg_val = $resolve_variable($bg_var_name, %true(), "f:get_variable_text_color.bg_val -> ")
  !endif

  !$dark_val  = $resolve_variable($dark_text_var_name, %true(), "f:get_variable_text_color.dark_val -> ")
  !$light_val = $resolve_variable($light_text_var_name, %true(), "f:get_variable_text_color.light_val -> ")

  !return $get_contrast_text_color($bg_val, $dark_val,$light_val )

!endfunction

!function $get_darken_percent($token)
  !$token = %upper($token)
  !if $token == "DARKEN"
    !return $DARKEN_DEFAULT_PERCENT
  !endif

  !if %strpos($token, "DARKEN_") == 0
    !return %intval(%substr($token, 7))
  !endif

  !return $DARKEN_DEFAULT_PERCENT

!endfunction

!function $is_too_dark($hex)

  !$lum = $hex_luminance($hex)

  !return ($lum <= $DARKNESS_THRESHOLD)

!endfunction

!function $normalize_darkness_floor($hex, $darkness_floor = $DARKNESS_THRESHOLD, $minimum_lighten_percent = 1)

    Assert_Literal_Color($hex, "f.normalize_darkness_floor")
    
    !$color = $normalize_hex_rgb($hex)
    !$darkness = $hex_luminance($color)

    Assert_If( ($darkness_floor < 0) || ($darkness_floor > 255), "Darkness floor must be between 0 and 255=[" + $darkness_floor + "] (f:normalize_darkness_floor)" )

    Assert_If( ($minimum_lighten_percent < 0) || ($minimum_lighten_percent > 100), "Minimum lighten percent must be between 0 and 100=[" + $minimum_lighten_percent + "] (f:normalize_darkness_floor)" )

    !if ($darkness <= 0)
        !return %upper($color)
    !endif

    !if ($darkness >= $darkness_floor)
        !return %upper($color)
    !endif

    !$shortfall = $darkness_floor - $darkness

    !$lighten_percent = %intval( ($shortfall * 100) / $darkness_floor )

    !if ($lighten_percent < $minimum_lighten_percent)
        !$lighten_percent = $minimum_lighten_percent
    !endif

    !if ($lighten_percent > 100)
        !$lighten_percent = 100
    !endif

    !$normalized = %lighten( $color, $lighten_percent )

    !$normalized = $normalize_hex_rgb($normalized)
    !$normalized_darkness = $hex_luminance($normalized)

    !$correction_count = 0
    !$maximum_corrections = 100

    !while ($normalized_darkness < $darkness_floor) && ($correction_count < $maximum_corrections)

        !$previous = $normalized

        !$normalized = %lighten($normalized,1)

        !$normalized = $normalize_hex_rgb($normalized)

        !if ($normalized == $previous)
            !$correction_count = $maximum_corrections
        !else
            !$normalized_darkness = $hex_luminance($normalized)
            !$correction_count = $correction_count + 1
        !endif

    !endwhile

    Assert_Literal_Color($normalized, "f.normalize_darkness_floor:upper:normalized")

    !return %upper($normalized)

!endfunction

!function $get_darker_semantic_token($token)
  !$token = %upper($token)

  Breakpoint_If( "DARKER_TOKEN_LITERAL", $is_literal_color($token), "get_darker_semantic_token token=[" + $token + "]" )

  !if ($is_literal_color($token))
      !return ""
  !endif

  !if $ends_with($token, "_LIGHT")

    !$candidate = %substr( $token,0,%strlen($token)-6 )

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""
      !return $candidate
    !endif

  !elseif $ends_with($token, "_DARK")

    !$base = %substr( $token, 0, %strlen($token)-5 )
    !$candidate = $base + "_DARKEST"
    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !elseif $ends_with($token, "_DARKEST")

    !return ""

  !else

    !$candidate = $token + "_DARK"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !endif

  !return ""

!endfunction

!function $darken_color($token, $darken_token = "DARKEN")

  Breakpoint_If( "DARKEN_MOTIVATION", %upper($token) == "#CCCCFF", "darken_color token=[" + $token + "] mode=[" + $darken_token + "]" )
  
  Assert_If( $is_special_style_token($token), "DARKEN cannot operate on special token=[" + $token + "] (f:darken_color)" )

  !if (%upper($darken_token) == "DARKEN")

    !$darker = $get_darker_semantic_token($token)

    !if $darker != ""
        !return $get_semantic_color($darker)
    !endif

  !endif

  !$color = $resolve_literal_color($token)

  !$pct = $get_darken_percent($darken_token)

  !$dark = %darken($color, $pct)

  !if ($normalize_hex_rgb($color) == "#FFFFFF") && ($normalize_hex_rgb($dark) == "#FFFFFF")

      !$dark = %darken("#FEFEFE", $pct)

  !endif

  Assert_Literal_Color($dark, "f.darken_color")

  !$dark = $normalize_hex_rgb($dark)

  !return $normalize_darkness_floor($dark)

!endfunction

!function $get_lighten_percent($token)
  !$token = %upper($token)
  !if $token == "LIGHTEN"
    !return $LIGHTEN_DEFAULT_PERCENT
  !endif

  !if %strpos($token, "LIGHTEN_") == 0
    !return %intval(%substr($token, 8))
  !endif

  !return $LIGHTEN_DEFAULT_PERCENT

!endfunction

!function $is_too_light($hex)

  !$lum = $hex_luminance($hex)

  !return ($lum >= $LIGHTNESS_THRESHOLD)

!endfunction

!function $normalize_lightness_ceiling($hex, $lightness_ceiling = $LIGHTNESS_THRESHOLD, $minimum_darken_percent = 1)

    Assert_Literal_Color($hex, "f.normalize_lightness_ceiling")

    !$color = $normalize_hex_rgb($hex)
    !$lightness = $hex_luminance($color)

    Assert_If( ($lightness_ceiling < 0) || ($lightness_ceiling > 255), "Lightness ceiling must be between 0 and 255=[" + $lightness_ceiling + "] (f:normalize_lightness_ceiling)" )

    Assert_If( ($minimum_darken_percent < 0) || ($minimum_darken_percent > 100), "Minimum darken percent must be between 0 and 100=[" + $minimum_darken_percent + "] (f:normalize_lightness_ceiling)" )

    !if ($lightness <= 0)
        !return %upper($color)
    !endif

    !if ($lightness <= $lightness_ceiling)
        !return %upper($color)
    !endif

    !$overage = $lightness - $lightness_ceiling

    !$darken_percent = %intval( ($overage * 100) / $lightness )

    !if ($darken_percent < $minimum_darken_percent)
        !$darken_percent = $minimum_darken_percent
    !endif

    !if ($darken_percent > 100)
        !$darken_percent = 100
    !endif

    !$normalized = %darken($color, $darken_percent)

    !$normalized = $normalize_hex_rgb($normalized)
    !$normalized_lightness = $hex_luminance($normalized)

    !$correction_count = 0
    !$maximum_corrections = 100

    !while ($normalized_lightness > $lightness_ceiling) && ($correction_count < $maximum_corrections)

        !$previous = $normalized

        !$normalized = %darken($normalized,1)

        !$normalized = $normalize_hex_rgb($normalized)

        !if ($normalized == $previous)
            !$correction_count = $maximum_corrections
        !else
            !$normalized_lightness = $hex_luminance($normalized)
            !$correction_count = $correction_count + 1
        !endif

    !endwhile

    Assert_Literal_Color($normalized, "f.normalize_lightness_ceiling")

    !return %upper($normalized)

!endfunction

!function $get_lighter_semantic_token($token)
  !$token = %upper($token)

  Breakpoint_If( "LIGHTER_TOKEN_LITERAL", $is_literal_color($token), "get_lighter_semantic_token token=[" + $token + "]" )

  !if ($is_literal_color($token))
      !return ""
  !endif

  !if $ends_with($token, "_DARKEST")

    !$base = %substr($token, 0, %strlen($token) - 8)
    !$candidate = $base + "_DARK"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !elseif $ends_with($token, "_DARK")

    !$candidate = %substr( $token, 0, %strlen($token) - 5 )

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !elseif $ends_with($token, "_LIGHTEST")

    !return ""

  !elseif $ends_with($token, "_LIGHT")

    !$candidate = $token + "EST"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !else

    !$candidate = $token + "_LIGHT"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !endif

  !return ""

!endfunction

!function $lighten_color($token, $lighten_token = "LIGHTEN")
  
  Breakpoint_If( "LIGHTEN_MOTIVATION", %upper($token) == "#CCCCFF", "lighten_color token=[" + $token + "] mode=[" + $lighten_token + "]" )

  Assert_If( $is_special_style_token($token), "LIGHTEN cannot operate on special token=[" + $token + "] (f:lighten_color)" )

  !if (%upper($lighten_token) == "LIGHTEN")

    !$lighter = $get_lighter_semantic_token($token)

    !if $lighter != ""
        !return $get_semantic_color($lighter)
    !endif

  !endif

  !$color = $resolve_literal_color($token)

  !$pct = $get_lighten_percent($lighten_token)

  !$light = %lighten($color, $pct)

  !if ($normalize_hex_rgb($color) == "#000000") && ($normalize_hex_rgb($light) == "#000000")

      !$light = %lighten("#010101", $pct)

  !endif

  Assert_Literal_Color($light, "f.lighten_color")

  !$light = $normalize_hex_rgb($light)

  !return $normalize_lightness_ceiling($light)

!endfunction

!function $first_context_color($context0="", $context1="", $context2="", $context3="", $context4="", $context5="", $context6="", $context7="" )

  !if ($context0 != "") && ($is_special_style_token($context0) == %false())
      !return $context0
  !endif

  !if ($context1 != "") && ($is_special_style_token($context1) == %false())
      !return $context1
  !endif

  !if ($context2 != "") && ($is_special_style_token($context2) == %false())
      !return $context2
  !endif

  !if ($context3 != "") && ($is_special_style_token($context3) == %false())
      !return $context3
  !endif

  !if ($context4 != "") && ($is_special_style_token($context4) == %false())
      !return $context4
  !endif

  !if ($context5 != "") && ($is_special_style_token($context5) == %false())
      !return $context5
  !endif

  !if ($context6 != "") && ($is_special_style_token($context6) == %false())
      !return $context6
  !endif

  !if ($context7 != "") && ($is_special_style_token($context7) == %false())
      !return $context7
  !endif

  !return ""

!endfunction

!function $resolve_style_color($tokenOrColor, $context0="", $context1="", $context2="", $context3="", $context4="", $context5="", $context6="", $context7="" )
  
  !$contextColor = $first_context_color($context0, $context1, $context2, $context3, $context4, $context5, $context6, $context7)
  
  Breakpoint_If( "STYLE_COLOR_HASH_TOKEN", (%strpos(%upper($tokenOrColor), "#") == 0) && ($is_literal_color($tokenOrColor) == %false()), "token=[" + $tokenOrColor + "] context=[" + $contextColor + "]" )
  
  !$contextAsToken = %upper($contextColor)
  !$token = %upper($tokenOrColor)

  Breakpoint_If("STYLE_COLOR_MOTIVATION.48", %strpos(%upper($tokenOrColor),"#MOTIVATION") >= 0, "token=[" + $tokenOrColor + "]")

  Breakpoint_If( "STYLE_COLOR_MOTIVATION.50", %upper($tokenOrColor) == "#CCCCFF", "resolve_style_color token=[" + $tokenOrColor + "] context=[" + $contextColor + "]" )

  Assert_If( ($tokenOrColor == "") && ($contextColor == ""), "BLANK.BLANK[" + $tokenOrColor + "] requires token or context (f:resolve_style_color)" )

  !if ($has_dollar($tokenOrColor))

    !$resolved = $resolve_variable( $tokenOrColor, %false() )

    !if ($resolved != "")

        !if (%upper("" + $resolved + "") == %upper("" + $tokenOrColor + ""))
            Trigger_Assert( "Recursive variable resolution detected. " + "variable=[" + $tokenOrColor + "] " + "value=[" + $resolved + "] " + "(f:resolve_style_color)" )
        !endif

        !return $resolve_style_color($resolved, $context0, $context1, $context2, $context3, $context4, $context5, $context6, $context7 )

    !else
        Trigger_Assert( "Variable reference could not be resolved. token=[" + $tokenOrColor + "] context=[" + $contextColor + "] (f:resolve_style_color)")
    !endif

  !endif

  !if ($is_literal_color($tokenOrColor))
    Trigger_Breakpoint( "STYLE_COLOR_LITERAL", "token=[" + $tokenOrColor + "]" )
    !return %upper($tokenOrColor)
  !endif

  !if ($token == "AUTO")
   
    Assert_Blank( $contextColor, "AUTO requires a context color (f:resolve_style_color)" )

    !return $get_auto_text_color($contextColor)

  !elseif ($token == "CURRENT")

      Assert_Blank($contextAsToken, "CURRENT requires a context color to determine CURRENT (f:resolve_style_color)" )

      Assert_If( ($contextAsToken == "CURRENT"), "CURRENT recursively calls CURRENT (f:resolve_style_color)" )

      !return $resolve_style_color($contextColor, $context0, $context1, $context2, $context3, $context4, $context5, $context6, $context7)

  !elseif (%strpos($token, "DARKEN") == 0)

      Assert_Blank( $contextColor, $tokenOrColor + " requires a context color (f:resolve_style_color)" )

      !return $darken_color( $contextColor, $tokenOrColor )

  !elseif (%strpos($token, "LIGHTEN") == 0)

      Assert_Blank($contextColor, $tokenOrColor + " requires a context color (f:resolve_style_color)" )

      !return $lighten_color($contextColor, $tokenOrColor )

  !elseif ($ends_with_text($tokenOrColor) == %true())
      !$base = %substr($tokenOrColor, 0,%strlen($tokenOrColor) - 5 )
      !return $get_semantic_text_color($base)
  !else

    Breakpoint_If( "STYLE_COLOR_SEMANTIC_HASH", (%strpos(%upper($tokenOrColor), "#") == 0), "HASH TOKEN=[" + $tokenOrColor + "]" )
    Assert_Hash_Token( $tokenOrColor, "resolve_style_color received hash token=[" + $tokenOrColor + "]" )
    !return $get_semantic_color($tokenOrColor)

  !endif

!endfunction
 
!function $resolve_literal_color($tokenOrColor)
  !$color = $resolve_style_color($tokenOrColor)

  Assert_Literal_Color($color, "f.resolve_literal_color")

  !return %upper($color)

!endfunction

!function $is_corrupted_hash_token($value)

    !if ($is_literal_color($value))
        !return %false()
    !endif

    !if (%strpos(%upper($value),$POUND) != 0)
        !return %false()
    !endif

    !return %true()

!endfunction

!function $is_corrupted_semantic_hash($value)

    !if ($is_literal_color($value))
        !return %false()
    !endif

    !if (%strpos(%upper($value),$POUND) != 0)
        !return %false()
    !endif

    !$candidate = %substr($value,%strlen($POUND))

    !if ($semantic_color_variable($candidate,%false()) != "")
        !return %true()
    !endif

    !return %false()

!endfunction

!function $Next_Corruption_Variable($remaining)

    !$remaining = %substr($remaining,1)

    !$pos = %strpos($remaining, $CORRUPTION_VARIABLE_DEL)

    !if ($pos < 0)
        Trigger_Internal_Error( "Malformed corruption registry=[" + $remaining + "]" )
    !endif

    !return %substr($remaining,0,$pos)

!endfunction

!procedure Breakpoint_Corrupted_Hash_Token($breakpoint_name,$variable_name,$value)

    Breakpoint_If($breakpoint_name,$is_corrupted_hash_token($value),"variable=[" + $variable_name + "] value=[" + $value + "]")

!endprocedure

!procedure Detect_Corrupted_Variable($breakpoint_name,$variable_name)

    !if ($variable_exists_safe($variable_name))

        !$value = %get_variable_value($to_var_name($variable_name))

        Breakpoint_Corrupted_Hash_Token($breakpoint_name,$variable_name,$value)

    !endif

!endprocedure

!procedure Breakpoint_Corrupted_Color_Variable($variable_name)

    Detect_Corrupted_Variable("CORRUPTED_VARIABLE",$variable_name)

!endprocedure

!function $remove_hash_prefix($value)

    !if ($is_corrupted_hash_token($value))
        !return %substr($value,%strlen($POUND))
    !endif

    !return $value

!endfunction

!function $repair_corrupted_semantic_hash($value)

    !if ($is_corrupted_semantic_hash($value) == %false())
        !return $value
    !endif

    !$semantic = %substr($value,%strlen($POUND))

    !return $get_semantic_color($semantic)

!endfunction

!procedure Repair_Corrupted_Variable($variable_name)

    !if ($variable_exists_safe($variable_name))

        !$current = %get_variable_value( $to_var_name($variable_name) )

        !if ($is_corrupted_hash_token($current))

            %set_variable_value( $to_var_name($variable_name), $remove_hash_prefix($current) )

        !endif

    !endif

!endprocedure

!procedure Repair_Color_Variable($variable_name)

    !if ($variable_exists_safe($variable_name))

        !$current = %get_variable_value( $to_var_name($variable_name) )

        !$fixed = $repair_corrupted_semantic_hash($current)

        !if ($fixed != $current)

            Breakpoint_If( "CORRUPTION_REPAIR", %true(), "variable=[" + $variable_name + "] old=[" + $current + "] new=[" + $fixed + "]" )

            %set_variable_value( $to_var_name($variable_name), $fixed )

        !endif

    !endif

!endprocedure

!procedure Sanitize_Resolved_Color($variable_name)

    !if ($variable_exists_safe($variable_name))

        !$value = %get_variable_value($to_var_name($variable_name))

        !if ($is_corrupted_semantic_hash($value))
            %set_variable_value($to_var_name($variable_name),$repair_corrupted_semantic_hash($value))
        !endif

    !endif

!endprocedure

!procedure Register_Corruption_Variable($variable_name)

    Register_Lib_Object($variable_name,$REGISTRY_CORRUPTION_VARIABLES)

!endprocedure

!function $Is_Corruption_Variable_Registered($variable_name)

    !return $object_registered($variable_name,$REGISTRY_CORRUPTION_VARIABLES)

!endfunction

!procedure Detect_Registered_Corruption_Variables( $breakpoint_name )

    !$remaining = $Registry_Get( $REGISTRY_CORRUPTION_VARIABLES )

    !$iteration = 0

    !while ($remaining != $CORRUPTION_VARIABLE_DEL)

        !$iteration = $iteration + 1

        !if ($iteration > 100)
            Trigger_Internal_Error( "Corruption registry iteration limit exceeded" )
        !endif

        !$remainingBody = %substr($remaining,1)

        !$pos = %strpos($remainingBody, $CORRUPTION_VARIABLE_DEL)
        !if ($pos < 0) 
            Trigger_Internal_Error( "Malformed corruption registry=[" + $remainingBody + "]" )
        !endif

        !$variable_name = %substr($remainingBody,0,$pos)

        !$remaining = $CORRUPTION_VARIABLE_DEL + %substr($remainingBody,$pos+1)

        !if ($variable_name != "")

            Detect_Corrupted_Variable( $breakpoint_name, $variable_name )

        !endif

    !endwhile

!endprocedure

!procedure Repair_Registered_Corruption_Variables()

    !$remaining = $Registry_Get( $REGISTRY_CORRUPTION_VARIABLES )

    !$iteration = 0

    !while ($remaining != $CORRUPTION_VARIABLE_DEL)

        !$iteration = $iteration + 1

        !if ($iteration > 100)
            Trigger_Internal_Error( "Corruption registry iteration limit exceeded" )
        !endif

        !$remaining = %substr($remaining,1)

        !$pos = %strpos($remaining, $CORRUPTION_VARIABLE_DEL)

        !if ($pos < 0)
            Trigger_Internal_Error( "Malformed corruption registry=[" + $remaining + "]" )
        !endif

        !$variable_name = %substr($remaining,0,$pos)

        !$remaining = $CORRUPTION_VARIABLE_DEL + %substr($remaining,$pos + 1)

        !if ($variable_name != "")
            Repair_Corrupted_Variable( $variable_name )
        !endif

    !endwhile

!endprocedure

!procedure Repair_Registered_Color_Variables()

    !$remaining = $Registry_Get( $REGISTRY_CORRUPTION_VARIABLES )

    !$iteration = 0

    !while ($remaining != $CORRUPTION_VARIABLE_DEL)

        !$iteration = $iteration + 1

        !if ($iteration > 100)
            Trigger_Internal_Error( "Color repair registry iteration limit exceeded" )
        !endif

        !$remaining = %substr($remaining,1)

        !$pos = %strpos($remaining, $CORRUPTION_VARIABLE_DEL)

        !if ($pos < 0)
            Trigger_Internal_Error( "Malformed corruption registry=[" + $remaining + "]" )
        !endif

        !$variable_name = %substr($remaining,0,$pos)

        !$remaining = $CORRUPTION_VARIABLE_DEL + %substr($remaining,$pos + 1)

        !if ($variable_name != "")
            Repair_Color_Variable( $variable_name )
        !endif

    !endwhile

!endprocedure

!procedure Dump_Corruption_Registry()

    Trigger_Breakpoint("CORRUPTION_REGISTRY","variables=[" + $Registry_Get($REGISTRY_CORRUPTION_VARIABLES) + "]")

!endprocedure

!function $archimate_base_entity($entity)
    !$e = %lower($entity)
    !$pos = %strpos($e,"-")
    !if ($pos >= 0)
        !return %substr($e,$pos + 1)
    !endif
    !return $e
!endfunction

!function $archimate_normalize_entity($entity)

    !$e = %lower($entity)

    !$e = $replace($e,"-","")

    !$e = $replace($e," ","")

    !return $e

!endfunction

!function $archimate_sprite_entity($entity)

    !return %lower($entity)

!endfunction

!function $archimate_entity_layer($entity)
    !$entity = $archimate_default_sprite_entity($entity)
    !$pos = %strpos($entity, "-")
    !if ($pos > 0)
        !return %upper(%substr($entity,0,$pos))
    !endif
    
    !return ""
    
!endfunction

!function $archimate_sprite_key($entity)

    !$sprite = $archimate_sprite_entity($entity)
    !if (%strpos($sprite,"-") < 0)
        !$sprite = $archimate_default_sprite_entity($entity)
    !endif

    !if ($sprite == "")
        !return ""
    !endif

    !return "sprite_arch_" + $replace(%lower($sprite),"-","_")

!endfunction

!function $archimate_layer_from_entity($entity)
    !$s = %lower($entity)
    !$pos = %strpos($s,"-")

    !if ($pos >= 0)
        !return %upper(%substr($s,0,$pos))
    !endif

    !if ($s == "business")
        !return "BUSINESS"

    !elseif ($s == "application")
        !return "APPLICATION"

    !elseif ($s == "technology")
        !return "TECHNOLOGY"

    !elseif ($s == "strategy")
        !return "STRATEGY"

    !elseif ($s == "motivation")
        !return "MOTIVATION"

    !elseif ($s == "implementation")
        !return "IMPLEMENTATION"

    !endif

    !return "OTHER"

!endfunction

