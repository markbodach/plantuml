'---------------------------------------------------------
' Hex Utilities
'
' RGB and hexadecimal color processing functions.
'
' Provides:
'   - Color validation
'   - RGB extraction
'   - Hex conversion
'   - Luminance calculation
'---------------------------------------------------------
' --- Importing: src/libs/stdlib/components/_hex.puml ---
'=========================================================
' Literal Color Validation
'
' Supports:
'   #RGB
'   #RRGGBB
'   #RRGGBBAA
'=========================================================

!function $is_hex_digit($c)

  !$c = %upper($c)

  !if %strpos("0123456789ABCDEF", $c) != -1
    !return %true()
  !endif

  !return %false()

!endfunction

!function $is_literal_color($value)

    Trigger_Breakpoint("IS_LITERAL_COLOR", "value=[" + $value + "] len=[" + %strlen($value) + "]")

    !$value = %upper($value)
    !$POUNDlen = %strlen($POUND)
    '
    ' Must start with #
    '
    !if (%substr($value,0,$POUNDlen) != $POUND )
        !return %false()
    !endif

    !$len = %strlen($value)

    !if ($len != 4) && ($len != 7) && ($len != 9)
        !return %false()
    !endif

    !$i = $POUNDlen

    !while ($i < $len)

        !if ($is_hex_digit(%substr($value,$i,1)) == %false())
            !return %false()
        !endif

        !$i = $i + 1

    !endwhile

    !return %true()

!endfunction


!function $assert_literal_color($value)

  !if ($is_literal_color($value) == %false())
    Trigger_Assert("Invalid literal color=[" + $value + "]")

  !endif

  !return $value

!endfunction


'=========================================================
' Hex Normalization
'
' Supports:
'   #RGB
'   #RRGGBB
'   #RRGGBBAA
'
' Returns:
'   #RRGGBB
'=========================================================

!function $normalize_hex_rgb($hex)

  $assert_literal_color($hex)
  !$len = %strlen($hex)

  '
  ' #RGB -> #RRGGBB
  '
  !if ($len == 4)

    !$r = %substr($hex,1,1)
    !$g = %substr($hex,2,1)
    !$b = %substr($hex,3,1)

    !return $POUND + $r + $r + $g + $g + $b + $b

  !endif

  '
  ' #RRGGBBAA -> #RRGGBB
  '
  !if ($len == 9)

    !return $POUND + %substr($hex,1,6)

  !endif

  '
  ' Assume #RRGGBB
  '
  !return %upper($hex)

!endfunction


'=========================================================
' Hex Decoder
'=========================================================

!function $hex_digit_value($c)

    !$c = %upper($c)

    !if ($c == "0")
        !return 0
    !elseif ($c == "1")
        !return 1
    !elseif ($c == "2")
        !return 2
    !elseif ($c == "3")
        !return 3
    !elseif ($c == "4")
        !return 4
    !elseif ($c == "5")
        !return 5
    !elseif ($c == "6")
        !return 6
    !elseif ($c == "7")
        !return 7
    !elseif ($c == "8")
        !return 8
    !elseif ($c == "9")
        !return 9
    !elseif ($c == "A")
        !return 10
    !elseif ($c == "B")
        !return 11
    !elseif ($c == "C")
        !return 12
    !elseif ($c == "D")
        !return 13
    !elseif ($c == "E")
        !return 14
    !elseif ($c == "F")
        !return 15
    !endif

    Trigger_Internal_Error( "Invalid hex digit=[" + $c + "]")

    !return -1
!endfunction


'=========================================================
' Integer -> Hex Digit
'
' Input: 0-15
' Output: 0-F
'=========================================================

!function $int_to_hex_digit($n)

    Assert_If( ($n < 0) || ($n > 15), "Hex digit out of range=[" + $n + "]" )

    !if $n == 0
        !return "0"
    !elseif $n == 1
        !return "1"
    !elseif $n == 2
        !return "2"
    !elseif $n == 3
        !return "3"
    !elseif $n == 4
        !return "4"
    !elseif $n == 5
        !return "5"
    !elseif $n == 6
        !return "6"
    !elseif $n == 7
        !return "7"
    !elseif $n == 8
        !return "8"
    !elseif $n == 9
        !return "9"
    !elseif $n == 10
        !return "A"
    !elseif $n == 11
        !return "B"
    !elseif $n == 12
        !return "C"
    !elseif $n == 13
        !return "D"
    !elseif $n == 14
        !return "E"
    !else
        !return "F"
    !endif

!endfunction

'=========================================================
' Byte -> 2 Digit Hex
'
' Input: 0-255
' Output: 00-FF
'=========================================================

!function $byte_to_hex($n)

    Assert_If( ($n < 0) || ($n > 255), "Hex digit out of range=[" + $n + "]")

    !$hi = %intval($n / 16)
    !$lo = $n - ($hi * 16)

    !return $int_to_hex_digit($hi) + $int_to_hex_digit($lo)

!endfunction



!function $hex_byte_to_int($hexByte)

  !if (%strlen($hexByte) != 2)
      Trigger_Internal_Error("Invalid hex byte=[" + $hexByte + "]" )
  !endif

  !$hi = $hex_digit_value(%substr($hexByte,0,1))
  !$lo = $hex_digit_value(%substr($hexByte,1,1))

  !return ($hi * 16) + $lo

!endfunction


'=========================================================
' RGB Component Extraction
'=========================================================

!function $hex_red($hex)
  !$hex = $normalize_hex_rgb($hex)
  !return $hex_byte_to_int( %substr($hex,1,2) )

!endfunction


!function $hex_green($hex)
  !$hex = $normalize_hex_rgb($hex)
  !return $hex_byte_to_int( %substr($hex,3,2))
!endfunction


!function $hex_blue($hex)
  !$hex = $normalize_hex_rgb($hex)
  !return $hex_byte_to_int(%substr($hex,5,2) )

!endfunction


'=========================================================
' RGB Luminance
'
' W3C Relative Luminance Approximation
'
' Range:
'   0   = Black
'   255 = White
'=========================================================

!function $rgb_luminance($r,$g,$b)
  '!return ( (0.2126 * $r) + (0.7152 * $g) + (0.0722 * $b) )
  !return ( ((299 * $r) + (587 * $g) + (114 * $b)) / 1000)
!endfunction


!function $hex_luminance($hex)

  !$r = $hex_red($hex)
  !$g = $hex_green($hex)
  !$b = $hex_blue($hex)

  !return $rgb_luminance($r, $g, $b )

!endfunction




'=========================================================
' RGB -> #RRGGBB
'=========================================================

!function $rgb_to_hex($r,$g,$b)
  !return $POUND + $byte_to_hex($r) + $byte_to_hex($g) + $byte_to_hex($b)

!endfunction
