'---------------------------------------------------------
' String Utilities
'
' Core string manipulation helpers used throughout the
' framework.
'
' Provides:
'   - Prefix handling
'   - Suffix detection
'   - Style token detection
'---------------------------------------------------------
' --- Importing: src/libs/stdlib/components/_strings.puml ---


!function $strip_prefix($value, $prefix)

    !$prefixWithSeparator = $prefix + "_"

    !if %strpos($value, $prefixWithSeparator) == 0
        !return %substr(
            $value,
            %strlen($prefixWithSeparator)
        )
    !endif

    !return $value

!endfunction


!function $ends_with($value, $suffix)

  !$suffix_len = %strlen($suffix)
  !$value_len = %strlen($value)

  !if $value_len < $suffix_len
    !return %false()
  !endif

  !return %substr($value, $value_len - $suffix_len, $suffix_len) == $suffix

!endfunction

!function $ends_with_text($value)
  !return $ends_with($value, "_TEXT")

!endfunction


!function $is_special_style_token($token)
  !$tokenU = %upper($token)

  'token value should not be coming in with a prefix, like being processed by get_semantic_color
  !if $tokenU == "AUTO" 
    !return %true()
  !elseif $tokenU == "CURRENT"
    !return %true()
  !elseif %strpos($tokenU,"DARKEN") == 0
    !return %true()
  !elseif %strpos($tokenU,"LIGHTEN") == 0
    !return %true()
  !endif

  !return %false()

!endfunction

' --- End Import: src/libs/stdlib/components/_strings.puml ---



'---------------------------------------------------------
' Variable Utilities
'
' Dynamic PlantUML variable resolution, validation,
' existence checking, and indirection helpers.
'
' Provides:
'   - Variable lookup
'   - Dynamic variable access
'   - Variable validation
'---------------------------------------------------------
' --- Importing: src/libs/stdlib/components/_variables.puml ---
'---------------------------------------------------------
' Variable Helpers
'---------------------------------------------------------

!function $has_dollar($name)
    !return (%strlen($name) > 0) && (%substr($name, 0, 1) == %chr(36))
!endfunction


!function $strip_dollar($name)

    !if ($has_dollar($name) == %false())
        !return $name
    !endif

    !$clean = %substr($name, 1)

    !if ($has_dollar($clean) == %true())
        !assert 0 == 1 : "MB_UML :: Variable name has multiple leading dollar signs=[" + $name + "]"
    !endif

    !return $clean

!endfunction


!function $to_var_name($name)
    !return %chr(36) + $strip_dollar($name)
!endfunction


!function $is_valid_variable_name($name)

    !if ($name == "")
        !return %false()
    !endif

    !if ($has_dollar($name) == %false())
        !return %false()
    !endif

    !$clean = $strip_dollar($name)

    !if $clean == ""
        !return %false()
    !endif

    !if ($clean != %upper($clean))
        !return %false()
    !endif

    !return %true()

!endfunction



!function $variable_exists_safe($name, $raise_error = %false())

    !$variable_name = $to_var_name($name)

    !if ($is_valid_variable_name($variable_name) == %false())

        !if ($raise_error == %true())
            !if ($variable_name != %upper($variable_name))
                !assert 0 == 1 : "MB_UML :: Variable names must be uppercase=[" + $variable_name + "]"
            !else
                !assert 0 == 1 : "MB_UML :: Invalid variable name=[" + $variable_name + "]"
            !endif
        !endif

        !return %false()

    !endif

    !return %variable_exists($variable_name)

!endfunction


'
' Resolves a dynamically named PlantUML variable.
'
' Accepted inputs:
'   COLOR_PRIMARY
'   $COLOR_PRIMARY
'
!function $resolve_variable($name, $raise_error = %true())

    !$variable_name = $to_var_name($name)
    !$value = ""

    !if ($variable_exists_safe($variable_name, $raise_error) == %false())

        !if ($raise_error == %true())
            !assert 0 == 1 : "MB_UML :: Invalid variable name or undefined variable=[" + $variable_name + "]"
        !endif

        !return ""

    !endif

    !$value = %get_variable_value($variable_name)

    !return $value

!endfunction
