  '
  ' Literal color
  '
  !if ($is_literal_color($tokenOrColor))
    Trigger_Breakpoint( "STYLE_COLOR_LITERAL", "token=[" + $tokenOrColor + "]" )
    !return %upper($tokenOrColor)
  !endif



  '
  ' AUTO
  '
  !if ($token == "AUTO")
   
    Assert_Blank( $contextColor, "AUTO requires a context color (f:resolve_style_color)" )

    !return $get_auto_text_color($contextColor)

  '
  ' CURRENT
  '
  !elseif ($token == "CURRENT")

      Assert_Blank($contextAsToken, "CURRENT requires a context color to determine CURRENT (f:resolve_style_color)" )

      Assert_If( ($contextAsToken == "CURRENT"), "CURRENT recursively calls CURRENT (f:resolve_style_color)" )

      !return $resolve_style_color($contextColor, $context0, $context1, $context2, $context3, $context4, $context5, $context6, $context7)

  '
  ' DARKEN
  '
  !elseif (%strpos($token, "DARKEN") == 0)

      Assert_Blank( $contextColor, $tokenOrColor + " requires a context color (f:resolve_style_color)" )

      !return $darken_color( $contextColor, $tokenOrColor )

  '
  ' LIGHTEN
  '
  !elseif (%strpos($token, "LIGHTEN") == 0)

      Assert_Blank($contextColor, $tokenOrColor + " requires a context color (f:resolve_style_color)" )

      !return $lighten_color($contextColor, $tokenOrColor )

  !elseif ($ends_with_text($tokenOrColor) == %true())
      !$base = %substr($tokenOrColor, 0,%strlen($tokenOrColor) - 5 )
      !return $get_semantic_text_color($base)
  '
  ' Semantic color token
  '
  !else

    'Trigger_Breakpoint( "STYLE_COLOR_SEMANTIC", "token=[" + $tokenOrColor + "]" )
    'Breakpoint_If( "STYLE_COLOR_SEMANTIC_HASH", (%strpos(%upper($tokenOrColor), "#") == 0), "token=[" + $tokenOrColor + "] context=[" + $contextColor + "]" )
    Breakpoint_If( "STYLE_COLOR_SEMANTIC_HASH", (%strpos(%upper($tokenOrColor), "#") == 0), "HASH TOKEN=[" + $tokenOrColor + "]" )
    Assert_Hash_Token( $tokenOrColor, "resolve_style_color received hash token=[" + $tokenOrColor + "]" )
    !return $get_semantic_color($tokenOrColor)

  !endif


!endfunction
 

 !function $resolve_literal_color($tokenOrColor)
  !$color = $resolve_style_color($tokenOrColor)

  $assert_literal_color($color)
  !return %upper($color)

!endfunction
