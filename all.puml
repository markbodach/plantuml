'---------------------------------------------------------
' Brightness Detection
'---------------------------------------------------------

!function $is_too_light($hex)

  !$lum = $hex_luminance($hex)

  !return ($lum >= $LIGHTNESS_THRESHOLD)

!endfunction



'---------------------------------------------------------
' Normalize Lightness Ceiling
'
' Prevents a color from becoming lighter than the configured
' lightness ceiling.
'
' Behavior:
'   - Normalizes #RGB and #RRGGBBAA to #RRGGBB.
'   - Returns compliant colors unchanged.
'   - Darkens proportionally based on how far the color is
'     above the lightness ceiling.
'   - Avoids direct fractional RGB-channel scaling.
'   - Applies bounded follow-up corrections for rounding.
'
' Existing usage remains valid:
'
'   $normalize_lightness_ceiling("#D6EAF8")
'
'---------------------------------------------------------
!function $normalize_lightness_ceiling($hex, $lightness_ceiling = $LIGHTNESS_THRESHOLD, $minimum_darken_percent = 1)

    '
    ' Validate and normalize the input color.
    '
    $assert_literal_color($hex)

    !$color = $normalize_hex_rgb($hex)
    !$lightness = $hex_luminance($color)

    '
    ' Validate the lightness ceiling.
    '
    !if ($lightness_ceiling < 0) || ($lightness_ceiling > 255)
        !assert 0 == 1 : "MB_UML :: Lightness ceiling must be between 0 and 255=[" + $lightness_ceiling + "]"
    !endif

    '
    ' Validate the minimum correction.
    '
    !if ($minimum_darken_percent < 0) || ($minimum_darken_percent > 100)
        !assert 0 == 1 : "MB_UML :: Minimum darken percent must be between 0 and 100=[" + $minimum_darken_percent + "]"
    !endif

    '
    ' A color with zero calculated lightness cannot exceed
    ' a valid lightness ceiling.
    '
    !if ($lightness <= 0)
        !return %upper($color)
    !endif

    '
    ' The color already satisfies the lightness ceiling.
    '
    !if ($lightness <= $lightness_ceiling)
        !return %upper($color)
    !endif

    '
    ' Determine how far the color exceeds the ceiling.
    '
    !$overage = $lightness - $lightness_ceiling

    '
    ' Convert the overage into a proportional darkening
    ' percentage.
    '
    ' Example:
    '
    '   Lightness = 235
    '   Ceiling   = 223
    '   Overage   = 12
    '   Percent   = (12 * 100) / 235
    '
    !$darken_percent = %intval( ($overage * 100) / $lightness )

    '
    ' Apply the configured minimum correction.
    '
    !if ($darken_percent < $minimum_darken_percent)
        !$darken_percent = $minimum_darken_percent
    !endif

    '
    ' Protect the PlantUML darkening operation.
    '
    !if ($darken_percent > 100)
        !$darken_percent = 100
    !endif

    '
    ' Apply the initial proportional correction.
    '
    !$normalized = %darken($color, $darken_percent)

    !$normalized = $normalize_hex_rgb($normalized)
    !$normalized_lightness = $hex_luminance($normalized)

    '
    ' PlantUML color calculations and integer rounding may
    ' leave the result slightly above the lightness ceiling.
    '
    ' Apply bounded one-percent corrections until the color
    ' reaches the configured ceiling.
    '
    !$correction_count = 0
    !$maximum_corrections = 100

    !while ($normalized_lightness > $lightness_ceiling) && ($correction_count < $maximum_corrections)

        !$previous = $normalized

        !$normalized = %darken($normalized,1)

        !$normalized = $normalize_hex_rgb($normalized)

        '
        ' Stop if PlantUML no longer changes the color.
        '
        !if ($normalized == $previous)
            !$correction_count = $maximum_corrections
        !else
            !$normalized_lightness = $hex_luminance($normalized)
            !$correction_count = $correction_count + 1
        !endif

    !endwhile

    $assert_literal_color($normalized)

    !return %upper($normalized)

!endfunction

'---------------------------------------------------------
' Semantic Token Progression
'
' DARKEST -> DARK
' DARK -> BASE
' BASE -> LIGHT
' LIGHT -> LIGHTEST
'
' PRIMARY_DARKEST
'     -> PRIMARY_DARK
'
' PRIMARY_DARK
'     -> PRIMARY
'
' PRIMARY
'     -> PRIMARY_LIGHT
'
' PRIMARY_LIGHT
'     -> PRIMARY_LIGHTEST
'
' PRIMARY_LIGHTEST
'     -> RGB Lightening
'---------------------------------------------------------

!function $get_lighter_semantic_token($token)
  !$token = %upper($token)
  !if ($is_literal_color($token))
      !return ""
  !endif

  '
  ' PRIMARY_DARKEST -> PRIMARY_DARK
  '
  !if $ends_with($token, "_DARKEST")

    !$base = %substr($token, 0, %strlen($token) - 8)
    !$candidate = $base + "_DARK"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif


  '
  ' PRIMARY_DARK -> PRIMARY
  '
  !elseif $ends_with($token, "_DARK")

    !$candidate = %substr( $token, 0, %strlen($token) - 5 )

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif


  '
  ' PRIMARY_LIGHTEST
  ' No lighter semantic promotion available
  '
  !elseif $ends_with($token, "_LIGHTEST")

    !return ""


  '
  ' PRIMARY_LIGHT -> PRIMARY_LIGHTEST
  '
  !elseif $ends_with($token, "_LIGHT")

    !$candidate = $token + "EST"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif


  '
  ' PRIMARY -> PRIMARY_LIGHT
  '
  !else

    !$candidate = $token + "_LIGHT"

    !if $resolve_variable( $semantic_color_variable($candidate), %false() ) != ""

      !return $candidate

    !endif

  !endif

  !return ""

!endfunction


'---------------------------------------------------------
' Lighten Resolver
'
' Resolution Order:
'
'   1. Semantic Progression
'      DARKEST -> DARK
'      DARK -> BASE
'      BASE -> LIGHT
'      LIGHT -> LIGHTEST
'
'   2. RGB Lightening
'
'   3. Threshold Clamp
'---------------------------------------------------------

!function $lighten_color($token, $lighten_token = "LIGHTEN")
  
  !if $is_special_style_token($token)
    !assert 0 == 1 : "MB_UML :: LIGHTEN (lighten_color) cannot operate on special token=[" + $token + "]"
  !endif

  '
  ' Step 1:
  ' Semantic progression
  '
  !if (%upper($lighten_token) == "LIGHTEN")

    !$lighter = $get_lighter_semantic_token($token)

    !if $lighter != ""
        !return $get_semantic_color($lighter)
    !endif

  !endif

  '
  ' Step 2:
  ' Resolve current color
  '
  !$color = $resolve_literal_color($token)

    '
  ' Step 3:
  ' Determine lighten percentage
  '
  !$pct = $get_lighten_percent($lighten_token)

  '
  ' Step 4:
  ' RGB Lightening
  '
  !$light = %lighten($color, $pct)

  !if ($normalize_hex_rgb($color) == "#000000") && ($normalize_hex_rgb($light) == "#000000")

      !$light = %lighten("#010101", $pct)

  !endif

  $assert_literal_color($light)

  !$light = $normalize_hex_rgb($light)

  !return $normalize_lightness_ceiling($light)

!endfunction
' --- End Import: src/libs/stdlib/components/_lighten.puml ---



'---------------------------------------------------------
' Style Resolver
'
' Central style resolution engine.
'
' Resolves:
'   - Semantic colors
'   - AUTO
'   - CURRENT
'   - DARKEN*
'   - LIGHTEN*
'   - Literal colors
'
' Acts as the primary color/style abstraction
' layer used by framework styles.
'---------------------------------------------------------
' --- Importing: src/libs/stdlib/components/_resolver.puml ---
!function $first_context_color($context0="", $context1="", $context2="", $context3="", $context4="", $context5="", $context6="", $context7="" )

  !if ($context0 != "") && ($is_special_style_token($context0) == %false())
      !return $context0
  !endif

  !if ($context1 != "") && ($is_special_style_token($context1) == %false())
      !return $context1
  !endif

  !if ($context2 != "") && ($is_special_style_token($context2) == %false())
      !return $context2
  !endif

  !if ($context3 != "") && ($is_special_style_token($context3) == %false())
      !return $context3
  !endif

  !if ($context4 != "") && ($is_special_style_token($context4) == %false())
      !return $context4
  !endif

  !if ($context5 != "") && ($is_special_style_token($context5) == %false())
      !return $context5
  !endif

  !if ($context6 != "") && ($is_special_style_token($context6) == %false())
      !return $context6
  !endif

  !if ($context7 != "") && ($is_special_style_token($context7) == %false())
      !return $context7
  !endif

  !return ""

!endfunction



!function $resolve_style_color($tokenOrColor, $context0="", $context1="", $context2="", $context3="", $context4="", $context5="", $context6="", $context7="" )
  '!$tokenOrColorIsSpecial = $is_special_style_token($tokenOrColor)
  !$contextColor = $first_context_color($context0, $context1, $context2, $context3, $context4, $context5, $context6, $context7)
  
  !$contextAsToken = %upper($contextColor)
  !$token = %upper($tokenOrColor)

  '
  ' Validation
  '
  !if ($tokenOrColor == "") && ($contextColor == "")
      !assert 0 == 1 : "MB_UML :: BLANK.BLANK[" + $tokenOrColor + "] (resolve_style_color) requires a tokenOrColor or context color"
  !endif

  '
  ' AUTO
  '
  !if ($token == "AUTO")

    !if ($contextColor == "")
      !assert 0 == 1 : "MB_UML :: AUTO (resolve_style_color) requires a context color"
    !endif
    !return $get_auto_text_color($contextColor)

  '
  ' CURRENT
  '
  !elseif ($token == "CURRENT")

      !if ($contextAsToken == "")
          !assert 0 == 1 : "MB_UML :: CURRENT (resolve_style_color) requires a context color to determine CURRENT"
      !endif
      !if ($contextAsToken == "CURRENT")
          !assert 0 == 1 : "MB_UML :: CURRENT (resolve_style_color) recursively calls CURRENT"
      !endif

      !return $resolve_style_color($contextColor)

  '
  ' DARKEN
  '
  !elseif (%strpos($token, "DARKEN") == 0)

      !if ($contextColor == "")
          !assert 0 == 1 : "MB_UML :: " + $tokenOrColor + " (resolve_style_color) requires a context color"
      !endif

      !return $darken_color( $contextColor, $tokenOrColor )

  '
  ' LIGHTEN
  '
  !elseif (%strpos($token, "LIGHTEN") == 0)

      !if ($contextColor == "")
          !assert 0 == 1 : "MB_UML :: " + $tokenOrColor + " (resolve_style_color) requires a context color"
      !endif

      !return $lighten_color($contextColor, $tokenOrColor )

  '
  ' Literal color
  '
  !elseif ($is_literal_color($tokenOrColor))
      !return %upper($tokenOrColor)
  '
  ' Semantic text token
  '
  !elseif ($ends_with_text($tokenOrColor) == %true())
      !$base = %substr($tokenOrColor, 0,%strlen($tokenOrColor) - 5 )
      !return $get_semantic_text_color($base)
  '
  ' Semantic color token
  '
  !else
      !return $get_semantic_color($tokenOrColor)
  !endif

!endfunction
 

 !function $resolve_literal_color($tokenOrColor)
  !$color = $resolve_style_color($tokenOrColor)

  $assert_literal_color($color)
  !return %upper($color)
!endfunction
