!procedure Load_Theme_OntarioHealth_Colors()

    'Set OH Colours
    !global $COLOR_PRIMARY = $COLOR_OH_PRIMARY
    !global $COLOR_PRIMARY_LIGHT = $COLOR_OH_PRIMARY_LIGHT
    !global $COLOR_PRIMARY_DARK = $COLOR_OH_PRIMARY_DARK

    !global $COLOR_WARNING = $COLOR_OH_WARNING
    !global $COLOR_WARNING_LIGHT = $COLOR_OH_WARNING_LIGHT
    !global $COLOR_WARNING_DARK = $COLOR_OH_WARNING_DARK

    !global $COLOR_SUCCESS = $COLOR_OH_SUCCESS
    !global $COLOR_SUCCESS_LIGHT = $COLOR_OH_SUCCESS_LIGHT
    !global $COLOR_SUCCESS_DARK = $COLOR_OH_SUCCESS_DARK

    !global $COLOR_ERROR = $COLOR_OH_ERROR
    !global $COLOR_ERROR_LIGHT = $COLOR_OH_ERROR_LIGHT
    !global $COLOR_ERROR_DARK = $COLOR_OH_ERROR_DARK

    !global $COLOR_TEXT = $COLOR_OH_TEXT
    !global $COLOR_BORDER = $COLOR_OH_BORDER


    !global $COLOR_DISABLED_DARK = $COLOR_OH_LABEL
    !global $COLOR_DISABLED = $COLOR_OH_PLACEHOLDER

!endprocedure


!procedure Load_Theme_OntarioHealth_ArchimateColors()
    'If there are a lot of variables, this could be moved into a separate _archimate.puml file
    !if ($ARCHIMATE_LIB_ENABLED == %true() )

        Apply_If("COLOR_MOTIVATION",     "COLOR_OH_MOTIVATION")
        Apply_If("COLOR_BUSINESS",       "COLOR_OH_BUSINESS")
        Apply_If("COLOR_APPLICATION",    "COLOR_OH_APPLICATION")
        Apply_If("COLOR_LOGICAL",        "COLOR_OH_LOGICAL")
        Apply_If("COLOR_DEPLOYMENT",     "COLOR_OH_DEPLOYMENT")
        Apply_If("COLOR_TECHNOLOGY",     "COLOR_OH_TECHNOLOGY")
        Apply_If("COLOR_PHYSICAL",       "COLOR_OH_PHYSICAL")
        Apply_If("COLOR_IMPLEMENTATION", "COLOR_OH_IMPLEMENTATION")
        Apply_If("COLOR_EXTERNAL",       "COLOR_OH_EXTERNAL")

        Apply_If("COLOR_MOTIVATION_LIGHT",     "COLOR_OH_MOTIVATION_LIGHT")
        Apply_If("COLOR_MOTIVATION_DARK",      "COLOR_OH_MOTIVATION_DARK")

        Apply_If("COLOR_STRATEGY_LIGHT",       "COLOR_OH_STRATEGY_LIGHT")
        Apply_If("COLOR_STRATEGY_DARK",        "COLOR_OH_STRATEGY_DARK")

        Apply_If("COLOR_BUSINESS_LIGHT",       "COLOR_OH_BUSINESS_LIGHT")
        Apply_If("COLOR_BUSINESS_DARK",        "COLOR_OH_BUSINESS_DARK")

        Apply_If("COLOR_APPLICATION_LIGHT",    "COLOR_OH_APPLICATION_LIGHT")
        Apply_If("COLOR_APPLICATION_DARK",     "COLOR_OH_APPLICATION_DARK")

        Apply_If("COLOR_TECHNOLOGY_LIGHT",     "COLOR_OH_TECHNOLOGY_LIGHT")
        Apply_If("COLOR_TECHNOLOGY_DARK",      "COLOR_OH_TECHNOLOGY_DARK")

        Apply_If("COLOR_IMPLEMENTATION_LIGHT", "COLOR_OH_IMPLEMENTATION_LIGHT")
        Apply_If("COLOR_IMPLEMENTATION_DARK",  "COLOR_OH_IMPLEMENTATION_DARK")

        Apply_If("COLOR_PHYSICAL_LIGHT",       "COLOR_OH_PHYSICAL_LIGHT")
        Apply_If("COLOR_PHYSICAL_DARK",        "COLOR_OH_PHYSICAL_DARK")

        Apply_If("COLOR_HIGHLIGHTED_LIGHT",    "COLOR_OH_HIGHLIGHTED_LIGHT")
        Apply_If("COLOR_HIGHLIGHTED_DARK",     "COLOR_OH_HIGHLIGHTED_DARK")

        Apply_If("COLOR_NEW_LIGHT",            "COLOR_OH_NEW_LIGHT")
        Apply_If("COLOR_NEW_DARK",             "COLOR_OH_NEW_DARK")



    !endif

!endprocedure

