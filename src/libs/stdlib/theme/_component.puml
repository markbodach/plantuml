    !global $COLOR_BACKGROUND_COMPONENT ?= $COLOR_PRIMARY
    !global $ALIGNMENT_HORIZONTAL_COMPONENT ?= "left"

    !global $MARGIN_COMPONENT ?= 20
    !global $PADDING_COMPONENT ?= 15

    
