!procedure Load_Lib_Theme_StdLib_Spacing()

'---------------------------------------------------------
' Bootstrap-inspired spacing scale
'---------------------------------------------------------

!global $SPACING_UNIT_ENABLED ?= %true()
!global $SPACING_UNIT ?= 5


!if $SPACING_UNIT_ENABLED == %true()
    !global $SPACING_0 ?= 0
    !global $SPACING_1 ?= ($SPACING_UNIT * 1)
    !global $SPACING_2 ?= ($SPACING_UNIT * 2)
    !global $SPACING_3 ?= ($SPACING_UNIT * 3)
    !global $SPACING_4 ?= ($SPACING_UNIT * 4)
    !global $SPACING_5 ?= ($SPACING_UNIT * 6)

!else
    !global $SPACING_0 ?= 0
    !global $SPACING_1 ?= 5
    !global $SPACING_2 ?= 10
    !global $SPACING_3 ?= 15
    !global $SPACING_4 ?= 20
    !global $SPACING_5 ?= 30
    
!endif

!endprocedure