    !else 
        rectangle "$debug_body" as DOC_BODY <<documentRegion>> <<documentRegionBody>> {
    !endif
    Document_CreateAnchor($debug_anchor, DOC_BODY_TOP, layoutAnchorBody, $widthStereo,  $debug_tf) 
