    !$debug_anchor = " "
    !if ($debug_tf) 
        !$debug_footer = "Document_Footer"
        !$debug_anchor = "Document_Footer_Anchor_TOP"
        rectangle "$debug_footer" as DOC_FOOTER <<documentRegion>><<documentRegionFooter>><<documentRegionDebug>> {
    !else 
        rectangle "$debug_footer" as DOC_FOOTER <<documentRegion>><<documentRegionFooter>> {
    !endif
    Document_CreateAnchor($debug_anchor, DOC_FOOTER_TOP, layoutAnchorFooter, $widthStereo, $debug_tf) 

!endprocedure

!procedure Document_FooterEnd($widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)
    !$debug_anchor = " "
    !if ($debug_tf)
        !$debug_anchor = "Document_Footer_Anchor_Bottom"
    !endif
    Document_CreateAnchor($debug_anchor, DOC_FOOTER_BOTTOM, layoutAnchorFooter, $widthStereo, $debug_tf) 
    
    }

    Document_ValidateRegion("FOOTER")
    !if ($DOC_FOOTER_EMPTY == %true() )
        Document_CreateRel(DOC_FOOTER_TOP, DOC_FOOTER_BOTTOM)
    !endif 

!endprocedure


!procedure DocumentEnd()

    
    Document_CreateRel(DOC_HEADER_ANCHOR_BOTTOM, DOC_BODY_TOP)
    Document_CreateRel(DOC_BODY_BOTTOM, DOC_FOOTER_TOP)
    
    
!endprocedure


