
!procedure Document_CreateAnchor($name, $alias, $stereotype, $widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)
    !if ($debug_tf)
        card "$name" as $alias <<layoutAnchor>> <<$stereotype>> <<$widthStereo>> <<layoutAnchorDebug>>
    !else
        card "" as $alias <<layoutAnchor>> <<$stereotype>> <<$widthStereo>>
    !endif
!endprocedure

!procedure Document_CreateRel($top, $bottom)

    $top -[hidden]down-> $bottom

!endprocedure


!procedure Document_Header($widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)

top to bottom direction

!$debug_header = " "
!$debug_anchor = " "
!if ($debug_tf) 
    !$debug_header = "Document_Header"
    !$debug_anchor = "Document_Header_Anchor"
    rectangle "$debug_header" as DOC_HEADER <<documentRegion>> <<documentRegionHeader>> <<documentRegionDebug>> {
!else 
    rectangle "$debug_header" as DOC_HEADER <<documentRegion>> <<documentRegionHeader>> {
!endif
Document_CreateAnchor($debug_anchor, DOC_HEADER_ANCHOR, layoutAnchorHeader, $widthStereo, $debug_tf)
!endprocedure

!procedure Document_HeaderEnd()
    }
!endprocedure

!procedure Document_Body($widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)
    !$debug_body = " "
    !$debug_anchor = " "
    !if ($debug_tf) 
        !$debug_body = "Document_Body"
        !$debug_anchor = "Document_Body_Anchor_Top"
        rectangle "$debug_body" as DOC_BODY <<documentRegion>> <<documentRegionBody>> <<documentRegionDebug>> {
    !else 
        rectangle "$debug_body" as DOC_BODY <<documentRegion>> <<documentRegionBody>> {
    !endif
    Document_CreateAnchor($debug_anchor, DOC_BODY_TOP, layoutAnchorBody, $widthStereo $debug_tf) 
!endprocedure

!procedure Document_BodyEnd($widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)
    !$debug_anchor = " "
    !if ($debug_tf)
        !$debug_anchor = "Document_Body_Anchor_Bottom"
    !endif
    Document_CreateAnchor($debug_anchor, DOC_BODY_BOTTOM, layoutAnchorBody, $widthStereo, $debug_tf) 
    
    Document_CreateRel(DOC_BODY_TOP, DOC_BODY_BOTTOM)
    
}
!endprocedure



!procedure Document_Footer($widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)
!$debug_footer = " "
!$debug_anchor = " "
!if ($debug_tf) 
    !$debug_footer = "Document_Footer"
    !$debug_anchor = "Document_Footer_Anchor"
    rectangle "$debug_footer" as DOC_FOOTER <<documentRegion>><<documentRegionFooter>><<documentRegionDebug>> {
!else 
    rectangle "$debug_footer" as DOC_FOOTER <<documentRegion>><<documentRegionFooter>> {
!endif
Document_CreateAnchor($debug_anchor, DOC_FOOTER_TOP, layoutAnchorFooter, $widthStereo, $debug_tf) 

!endprocedure

!procedure Document_FooterEnd()
    }
!endprocedure

!procedure DocumentEnd()

    Document_CreateRel(DOC_HEADER_ANCHOR, DOC_BODY_TOP)
    Document_CreateRel(DOC_BODY_BOTTOM, DOC_FOOTER_TOP)
    
!endprocedure


'==============================================================================
' Connect first body element to the body top anchor.
'==============================================================================
!procedure Body_AnchorToTop($element)
    Document_CreateRel(DOC_BODY_TOP, $element)
!endprocedure

'==============================================================================
' Connect last body element to the body bottom anchor.
'==============================================================================
!procedure Body_AnchorToBottom($element)
    Document_CreateRel($element, DOC_BODY_BOTTOM)
!endprocedure

'==============================================================================
' Connect body anchors to first and last content elements.
'==============================================================================
!procedure Body_AnchorTo($top, $bottom)
    Body_AnchorToTop($top)
    Body_AnchorToBottom($bottom)
!endprocedure
