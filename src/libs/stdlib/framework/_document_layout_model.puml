


!procedure Document_CreateAnchor($name, $alias, $stereotype, $widthStereo="diagramWidth", $debug_tf=$DOC_DEBUG)
    !if ($debug_tf)
        card "$name" as $alias <<layoutAnchor>> <<$stereotype>> <<$widthStereo>> <<layoutAnchorDebug>>
    !else
        card "" as $alias <<layoutAnchor>> <<$stereotype>> <<$widthStereo>>
    !endif
!endprocedure

!procedure Document_CreateRel($top, $bottom)

    $top -[hidden]down-> $bottom

!endprocedure


'==============================================================================
' Sets the current document region.
'==============================================================================
!procedure Document_SetCurrentRegion($region)
    %set_variable_value( "$DOC_CURRENT_REGION", $region )
!endprocedure

!function $RegionTopAnchor($region)
    !if ($region == "HEADER")
        !return "DOC_HEADER_ANCHOR_TOP"
    !elseif ($region == "BODY")
        !return "DOC_BODY_ANCHOR_TOP"
    !elseif ($region == "FOOTER")
        !return "DOC_FOOTER_ANCHOR_TOP"
    !endif
    !error "Unknown document region: " + $region
!endfunction

!function $RegionBottomAnchor($region)
    !if ($region == "HEADER")
        !return "DOC_HEADER_ANCHOR_BOTTOM"
    !elseif ($region == "BODY")
        !return "DOC_BODY_ANCHOR_BOTTOM"
    !elseif ($region == "FOOTER")
        !return "DOC_FOOTER_ANCHOR_BOTTOM"
    !endif
    !error "Unknown document region: " + $region
!endfunction


!procedure RegionFirst($element)
    !$vn = "$DOC_" + $DOC_CURRENT_REGION + "_EMPTY"
    %set_variable_value($vn, %false())

    !$vn = "$DOC_" + $DOC_CURRENT_REGION + "_HAS_FIRST" 
    %set_variable_value($vn, %true())

    Document_CreateRel( $RegionTopAnchor($DOC_CURRENT_REGION), $element )
!endprocedure

!procedure RegionLast($element)

    !$vn = "$DOC_" + $DOC_CURRENT_REGION + "_EMPTY"
    %set_variable_value($vn, %false())
    
    !$vn = "$DOC_" + $DOC_CURRENT_REGION + "_HAS_LAST" 
    %set_variable_value($vn, %true())

    Document_CreateRel( $element, $RegionBottomAnchor($DOC_CURRENT_REGION) )

!endprocedure

!procedure Document_ValidateRegion($region)

    !$hasFirstVar = "$DOC_" + $region + "_HAS_FIRST"
    !$hasLastVar  = "$DOC_" + $region + "_HAS_LAST"

    !$hasFirst = %get_variable_value($hasFirstVar)
    !$hasLast  = %get_variable_value($hasLastVar)

    !if ($hasFirst and !$hasLast)

        !error $region + " region contains RegionFirst() but no matching RegionLast()"

    !elseif (!$hasFirst and $hasLast)

        !error $region + " region contains RegionLast() but no matching RegionFirst()"

    !endif

!endprocedure




