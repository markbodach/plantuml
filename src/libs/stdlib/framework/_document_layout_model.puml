!function $Document_DebugStereo($debug_tf=$DOC_DEBUG)
    !if ($debug_tf)
        !return "<<documentRegionDebug>>"
    !endif
    !return ""
!endfunction

!function $Document_LayoutAnchorDebugStereo($debug_tf=$DOC_DEBUG)
    !if ($debug_tf)
        !return "<<layoutAnchorDebug>>"
    !endif
    !return ""
!endfunction


!procedure Document_Header($debug_tf=$DOC_DEBUG)

top to bottom direction

!$debug_header = " "
!$debug_anchor = " "
!if ($debug_tf) 
    !$debug_header = "Document_Header"
    !$debug_anchor = "Document_Header_Anchor"
    rectangle "$debug_header" as DOC_HEADER <<documentRegion>><<documentRegionHeader>><<documentRegionDebug>> {
        card "$debug_anchor" as DOC_HEADER_ANCHOR <<layoutAnchor>><<layoutAnchorHeader>><<diagramWidth>><<layoutAnchorDebug>>
!else 
    rectangle "$debug_header" as DOC_HEADER <<documentRegion>><<documentRegionHeader>> {
        card "$debug_anchor" as DOC_HEADER_ANCHOR <<layoutAnchor>><<layoutAnchorHeader>><<diagramWidth>>

!endif 
!endprocedure

!procedure Document_HeaderEnd()
    }
!endprocedure

!procedure Document_Body($debug_tf=$DOC_DEBUG)
!$debug_body = " "
!$debug_anchor = " "
!if ($debug_tf) 
    !$debug_body = "Document_Body"
    !$debug_anchor = "Document_Body_Anchor_Top"
    rectangle "$debug_body" as DOC_BODY <<documentRegion>><<documentRegionBody>><<documentRegionDebug>> {
        card "$debug_anchor" as DOC_BODY_TOP <<layoutAnchor>><<layoutAnchorBody>><<diagramWidth>><<layoutAnchorDebug>>
!else 
    rectangle "$debug_body" as DOC_BODY <<documentRegion>><<documentRegionBody>> {
        card "$debug_anchor" as DOC_BODY_TOP <<layoutAnchor>><<layoutAnchorBody>><<diagramWidth>>
!endif 
!endprocedure

!procedure Document_BodyEnd($debug_tf=$DOC_DEBUG)
!$debug_anchor = " "
!if ($debug_tf) 
    !$debug_anchor = "Document_Body_Anchor_Bottom"
        card "$debug_anchor" as DOC_BODY_BOTTOM <<layoutAnchor>><<layoutAnchorBody>><<diagramWidth>><<layoutAnchorDebug>>
!else 
        card "$debug_anchor" as DOC_BODY_BOTTOM <<layoutAnchor>><<layoutAnchorBody>><<diagramWidth>>
!endif 
    }
!endprocedure


!procedure Document_Footer($debug_tf=$DOC_DEBUG)
!$debug_footer = " "
!$debug_anchor = " "
!if ($debug_tf) 
    !$debug_footer = "Document_Footer"
    !$debug_anchor = "Document_Footer_Anchor"
    rectangle $debug_footer as DOC_FOOTER <<documentRegion>><<documentRegionFooter>><<documentRegionDebug>> {
        card $debug_anchor as DOC_FOOTER_TOP <<layoutAnchor>><<layoutAnchorFooter>><<diagramWidth>>
!else 
    rectangle $debug_footer as DOC_FOOTER <<documentRegion>><<documentRegionFooter>> {
        card $debug_anchor as DOC_FOOTER_TOP <<layoutAnchor>><<layoutAnchorFooter>><<diagramWidth>>
!endif 

!endprocedure

!procedure Document_FooterEnd()
    }
!endprocedure

!procedure DocumentEnd()

    DOC_HEADER_ANCHOR -[hidden]down-> DOC_BODY_TOP
    DOC_BODY_BOTTOM -[hidden]down-> DOC_FOOTER_TOP

!endprocedure
