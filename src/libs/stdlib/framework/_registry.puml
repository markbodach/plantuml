'=================================================================
' Extension Registry Framework
'=================================================================
'
' Provides registration and invocation support for themes, styles, skinparams, and future extension types.
'
' Themes are processed in registration order.
'
' Example:
'
'   Register_Lib_All("ThemeA")
'   Register_Lib_All("ThemeB")
'
' Execution Order:
'
'   ThemeA
'       ↓
'   ThemeB
'
' Registered extensions may provide:
'
'   Load_Theme_<Theme>()
'
'       Used for:
'           - Variables
'           - Theme initialization
'           - Configuration
'
'   Load_Styles_<Theme>()
'
'       Used for:
'           - Styles
'           - Stereotypes
'           - Formatting
'
'=================================================================
'
' REGISTRY
'
' Stores registered theme names using a delimiter-string
' registry implementation.
'
' Registry Format:
'
'   |ThemeA|
'
'   |ThemeA|ThemeB|
'
' Leading and trailing delimiters allow exact matching
' using %strpos() without partial-match collisions.
'
' Example:
'
'   |ThemeA|
'
'   |ThemeA|ThemeB|
'
'=================================================================

!global $THEMES = "|"
!global $SKINPARAMS = "|"
!global $STYLES = "|"

!global $REGISTRY_THEMES = "THEMES"
!global $REGISTRY_SKINPARAMS = "SKINPARAMS"
!global $REGISTRY_STYLES = "STYLES"



!function $Is_Theme_Registered($name)
    !return $object_registered($name, $REGISTRY_THEMES)
!endfunction

!function $Is_Skinparam_Registered($name)
    !return $object_registered($name, $REGISTRY_SKINPARAMS)
!endfunction

!function $Is_Style_Registered($name)
    !return $object_registered($name, $REGISTRY_STYLES)
!endfunction


!procedure Register_Lib_Theme($name)
    Register_Lib_Object($name, $REGISTRY_THEMES)
!endprocedure

!procedure Register_Lib_Skinparam($name)
    Register_Lib_Object($name, $REGISTRY_SKINPARAMS)
!endprocedure

!procedure Register_Lib_Style($name)
    Register_Lib_Object($name, $REGISTRY_STYLES)
!endprocedure

!procedure Register_Lib_All($name)
    Register_Lib_Theme($name)
    Register_Lib_Skinparam($name)
    Register_Lib_Style($name)
    
!endprocedure

!procedure Load_Registered_Themes()

    For_Each_Lib_Object("Load_Theme_", $REGISTRY_THEMES)

!endprocedure



!procedure Load_Registered_Skinparams()

    For_Each_Lib_Object("Load_Skinparams_", $REGISTRY_SKINPARAMS)

!endprocedure



!procedure Load_Registered_Styles()

    For_Each_Lib_Object("Load_Styles_", $REGISTRY_STYLES)

!endprocedure

