'=========================================================
' Extension Registry Framework
'=========================================================
'
' Provides registration and invocation support for themes, styles, skinparams, and future extension types.
'
' Themes are processed in registration order.
'
' Example:
'
'   Register_Lib_All("ThemeA")
'   Register_Lib_All("ThemeB")
'
' Execution Order:
'
'   ThemeA
'       ↓
'   ThemeB
'
' Registered extensions may provide:
'
'   Load_Theme_<Theme>()
'
'       Used for:
'           - Variables
'           - Theme initialization
'           - Configuration
'
'   Load_Styles_<Theme>()
'
'       Used for:
'           - Styles
'           - Stereotypes
'           - Formatting
'
'=========================================================



!function $Is_Theme_Registered($name)
    !return $object_registered($name, $REGISTRY_THEMES)
!endfunction

!function $Is_Skinparam_Registered($name)
    !return $object_registered($name, $REGISTRY_SKINPARAMS)
!endfunction

!function $Is_Style_Registered($name)
    !return $object_registered($name, $REGISTRY_STYLES)
!endfunction


!procedure Register_Lib_Theme($name)
    Register_Lib_Object($name, $REGISTRY_THEMES)
!endprocedure

!procedure Register_Lib_Skinparam($name)
    Register_Lib_Object($name, $REGISTRY_SKINPARAMS)
!endprocedure

!procedure Register_Lib_Style($name)
    Register_Lib_Object($name, $REGISTRY_STYLES)
!endprocedure

!procedure Register_Lib_All($name)
    Register_Lib_Theme($name)
    Register_Lib_Skinparam($name)
    Register_Lib_Style($name)
    
!endprocedure

!procedure Load_Registered_Themes()

    For_Each_Lib_Object("Load_Theme_", $REGISTRY_THEMES)

!endprocedure



!procedure Load_Registered_Skinparams()

    For_Each_Lib_Object("Load_Skinparams_", $REGISTRY_SKINPARAMS)

!endprocedure



!procedure Load_Registered_Styles()

    For_Each_Lib_Object("Load_Styles_", $REGISTRY_STYLES)

!endprocedure


!procedure Register_Lib_Theme_Derived($name)
    Register_Lib_Object($name, $REGISTRY_THEME_DERIVED)
!endprocedure

!procedure Build_Registered_Theme_Derived_Variables()
    For_Each_Lib_Object("Build_Lib_Derived_Variables_", $REGISTRY_THEME_DERIVED )
!endprocedure



'=========================================================
' STYLE EXTENSION HOOKS
'=========================================================
'
' The toolkit provides four optional extension procedures that
' allow consumers to customize variables and styles without
' modifying the toolkit source code.
'
'=========================================================
'
' LOADING ORDER
'
'   Load_Lib_Theme_BEFORE()
'       ↓
'   Load_Lib_Theme_Stdlib()
'   Load_Lib_Theme_Archimate()
'   Registered Theme Procedures
'       ↓
'   Load_Lib_Theme_AFTER()
'
'       ↓
'   Load_Lib_Skinparams_BEFORE()
'       ↓
'   Load_Lib_Skinparams_Stdlib()
'   Load_Lib_Skinparams_Archimate()
'   Registered Skinparams Procedures
'       ↓
'
'   Load_Lib_Styles_BEFORE()
'       ↓
'   Load_Lib_Styles_Stdlib()
'   Load_Lib_Styles_Archimate()
'   Registered Theme Style Procedures
'       ↓
'   Load_Lib_Styles_AFTER()
'
'=========================================================
'
' BEFORE HOOKS
'
' Intended for:
'
'   - Override toolkit defaults
'   - Configure variables
'   - Select active themes
'   - Replace framework values
'
' Example:
'
'   !procedure Load_Lib_Theme_BEFORE()
'
'       !$SPACING_UNIT = 8
'
'       !$ROUND_2 = 12
'
'   !endprocedure
'
'=========================================================
'
' AFTER HOOKS
'
' Intended for:
'
'   - Final overrides
'   - Project-specific stereotypes
'   - Local utility styles
'   - Style customizations
'
' Example:
'
'   !procedure Load_Lib_Styles_AFTER()
'
'   <style>
'
'   .projectCard {
'       Padding 20
'       RoundCorner 10
'   }
'
'   </style>
'
'   !endprocedure
'
'=========================================================
'
' RECOMMENDATIONS
'
'   Variables -> PRELOAD hooks
'
'   Styles    -> LOAD hooks
'
'   BEFORE    -> Configure toolkit behavior
'
'   AFTER     -> Override toolkit defaults
'
'=========================================================
'
' DEFAULT IMPLEMENTATIONS
'
' Consumers may redefine these procedures.
'
!procedure Load_Lib_Theme_BEFORE()
'DO NOT ADD CODE
!endprocedure


!procedure Load_Lib_Theme_AFTER()
'DO NOT ADD CODE
!endprocedure

!procedure Load_Lib_Skinparams_BEFORE()
'DO NOT ADD CODE
!endprocedure

!procedure Load_Lib_Skinparams_AFTER()
'DO NOT ADD CODE
!endprocedure

!procedure Load_Lib_Styles_BEFORE()
'DO NOT ADD CODE
!endprocedure

!procedure Load_Lib_Styles_AFTER()
'DO NOT ADD CODE
!endprocedure
'
'=========================================================






