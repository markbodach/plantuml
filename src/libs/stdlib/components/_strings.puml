

!function $strip_prefix($value, $prefix)

    !$prefixWithSeparator = $prefix + "_"

    !if %strpos($value, $prefixWithSeparator) == 0
        !return %substr(
            $value,
            %strlen($prefixWithSeparator)
        )
    !endif

    !return $value

!endfunction


!function $ends_with($value, $suffix)

  !$suffix_len = %strlen($suffix)
  !$value_len = %strlen($value)

  !if $value_len < $suffix_len
    !return %false()
  !endif

  !return %substr($value, $value_len - $suffix_len, $suffix_len) == $suffix

!endfunction

!function $ends_with_text($value)
  !return $ends_with($value, "_TEXT")

!endfunction


!function $is_special_style_token($token)
  !$tokenU = %upper($token)

  'token value should not be coming in with a prefix, like being processed by get_semantic_color
  !if $tokenU == "AUTO" 
    !return %true()
  !elseif $tokenU == "CURRENT"
    !return %true()
  !elseif %strpos($tokenU,"DARKEN") == 0
    !return %true()
  !elseif %strpos($tokenU,"LIGHTEN") == 0
    !return %true()
  !endif

  !return %false()

!endfunction


!function $array_singleton($value)
    !$tokens = []
    !$tokens[0] = $value
    !return $tokens
!endfunction


!function $to_array($value0=$UNSET, $value1=$UNSET, $value2=$UNSET, $value3=$UNSET, $value4=$UNSET, $value5=$UNSET, $value6=$UNSET, $value7=$UNSET, $value8=$UNSET, $value9=$UNSET)

  !$result = []
  !$resultIndex = 0
  !$i = 0

  !while ($i <= 9)

    !$variableName = "$value" + $i
    !$value = %get_variable_value($variableName)

    !if ($value != $UNSET) && ($value != "")

        !$result[$resultIndex] = $value
        !$resultIndex = $resultIndex + 1

    !endif

    !$i = $i + 1

  !endwhile

  !return $result

!endfunction

