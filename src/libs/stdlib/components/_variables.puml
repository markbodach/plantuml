'---------------------------------------------------------
' Variable Helpers
'---------------------------------------------------------

!function $has_dollar($name)
    !return (%strlen($name) > 0) && (%substr($name, 0, 1) == %chr(36))
!endfunction


!function $strip_dollar($name)

    !if ($has_dollar($name) == %false())
        !return $name
    !endif

    !$clean = %substr($name, 1)

    Assert_If( ($has_dollar($clean)), "Variable name has multiple leading dollar signs=[" + $name + "] (f:strip_dollar)" )


    !return $clean

!endfunction


!function $to_var_name($name)
    !return %chr(36) + $strip_dollar($name)
!endfunction


!function $is_valid_variable_name($name)

    !if ($name == "")
        !return %false()
    !endif

    !if ($has_dollar($name) == %false())
        !return %false()
    !endif

    !$clean = $strip_dollar($name)

    !if $clean == ""
        !return %false()
    !endif

    !if ($clean != %upper($clean))
        !return %false()
    !endif

    !return %true()

!endfunction



!function $variable_exists_safe($name, $raise_error = %false(), $trace_error = "")

    !$variable_name = $to_var_name($name)

    !if ($is_valid_variable_name($variable_name) == %false())

        !if ($raise_error == %true())
            !if ($variable_name != %upper($variable_name))
                Trigger_Assert("Variable names must be uppercase=[" + $variable_name + "] (" + $trace_error + "f:variable_exists_safe)" )

            !else 
                Trigger_Assert( "Invalid variable name=[" + $variable_name + "] (" + $trace_error + "f:variable_exists_safe)" )
            !endif
        !endif

        !return %false()

    !endif

    !return %variable_exists($variable_name)

!endfunction


'
' Resolves a dynamically named PlantUML variable.
'
' Accepted inputs:
'   COLOR_PRIMARY
'   $COLOR_PRIMARY
'
!function $resolve_variable($name, $raise_error = %true(), $trace_error = "")

    Assert_If( $is_literal_color($name), "Literal color passed where variable name expected=[" + $name + "] (" + $trace_error + "f:resolve_variable)" )

    !$variable_name = $to_var_name($name)
    !$value = ""

    !if ($variable_exists_safe($variable_name, $raise_error, $trace_error + "f:resolve_variable -> ") == %false())

        !if ($raise_error == %true())
            Trigger_Assert( "Invalid variable name or undefined variable=[" + $variable_name + ", " + $name + "] (" + $trace_error + "f:resolve_variable)" )
        !endif

        !return ""

    !endif

    !$value = %get_variable_value($variable_name)

    !return $value

!endfunction




'=========================================================
' First Defined Value
'
' Preserves:
'   ""
'
' Treats only:
'   $UNSET
'
' as undefined.
'
'=========================================================
!function $first_defined( $value0=$UNSET, $value1=$UNSET, $value2=$UNSET, $value3=$UNSET, $value4=$UNSET, $value5=$UNSET, $value6=$UNSET, $value7=$UNSET )

    !if ($value0 != $UNSET)
        !return $value0
    !endif

    !if ($value1 != $UNSET)
        !return $value1
    !endif

    !if ($value2 != $UNSET)
        !return $value2
    !endif

    !if ($value3 != $UNSET)
        !return $value3
    !endif

    !if ($value4 != $UNSET)
        !return $value4
    !endif

    !if ($value5 != $UNSET)
        !return $value5
    !endif

    !if ($value6 != $UNSET)
        !return $value6
    !endif

    !if ($value7 != $UNSET)
        !return $value7
    !endif

    !return $UNSET

!endfunction

'=========================================================
' First Non-Blank Value
'
' Returns the first value that is not blank.
'
' Safe for:
'   - Undefined variables
'   - Empty strings
'   - Literal colors
'   - Semantic tokens
'
' Similar to:
'
'   value0 ?? value1 ?? value2 ...
'
'=========================================================
!function $first_defined_variable( $var0="", $var1="", $var2="", $var3="", $var4="", $var5="", $var6="", $var7="" )

    !$v = $UNSET
    !if ($var0 != "")
        !$v = $resolve_variable($var0,%false())
        !if ($variable_exists_safe($var0))
            !return $v
        !endif
    !endif

    !if ($var1 != "")
        !$v = $resolve_variable($var1,%false())
        !if ($variable_exists_safe($var1))
            !return $v
        !endif
    !endif

    !if ($var2 != "")
        !$v = $resolve_variable($var2,%false())
        !if ($variable_exists_safe($var2))
            !return $v
        !endif
    !endif

        !if ($var3 != "")
        !$v = $resolve_variable($var3,%false())
        !if ($variable_exists_safe($var3))
            !return $v
        !endif
    !endif

    !if ($var4 != "")
        !$v = $resolve_variable($var4,%false())
        !if ($variable_exists_safe($var4))
            !return $v
        !endif
    !endif

    !if ($var5 != "")
        !$v = $resolve_variable($var5,%false())
        !if ($variable_exists_safe($var5))
            !return $v
        !endif
    !endif

    !if ($var6 != "")
        !$v = $resolve_variable($var6,%false())
        !if ($variable_exists_safe($var6))
            !return $v
        !endif
    !endif

    !if ($var7 != "")
        !$v = $resolve_variable($var7,%false())
        !if ($variable_exists_safe($var7))
            !return $v
        !endif
    !endif


    

    ' repeat through var7...

    !return $UNSET

!endfunction
