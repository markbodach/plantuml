
!function $strip_dollar($name)

  !if %substr($name, 0, 1) == "$"
    !return %substr($name, 1)
  !endif

  !return $name

!endfunction


'
' Resolves a PlantUML variable name and validates existence.
'
' Examples:
'   COLOR_PRIMARY
'   $COLOR_PRIMARY
'

!function $resolve_variable($name)

  !$value = %get_variable_value( $strip_dollar($name) )

  !if "$value" == ""
    !error MB_UML :: Unable to resolve variable name ($name): $var
  !endif

  !return $value

!endfunction

