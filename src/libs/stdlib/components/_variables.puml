
!function $is_variable_name($value)

  !if %substr($value, 0, 1) == "$"
    !return %true()
  !endif

  !$new_value = %get_variable_value( $strip_dollar($value) )

  !if "$new_value" == ""
    !return %false()
  !endif

  !return %false()

!endfunction


!function $strip_dollar($name)

  !if %substr($name, 0, 1) == "$"
    !return %substr($name, 1)
  !endif

  !return $name

!endfunction


'
' Resolves a PlantUML variable name and validates existence.
'
' Examples:
'   COLOR_PRIMARY
'   $COLOR_PRIMARY
'

!function $resolve_variable($name, $raiseError = %true() )

  !$value = %get_variable_value( $strip_dollar($name) )

  !if "$value" == ""
    !if $raiseError == %true()
        !error MB_UML :: Unable to resolve variable name ($name): $var
    !endif
  !endif

  !return $value

!endfunction

