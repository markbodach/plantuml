!function $has_dollar($name)
  !if %substr($name, 0, 1) == "$"
    !return %true()
  !endif
  !return %false()
!endfunction


!function $strip_dollar($name)
  !if $has_dollar($name) == %true()
    !return %substr($name, 1)
  !endif
  !return $name
!endfunction




'
' Resolves a PlantUML variable name and validates existence.
'
' Examples:
'   COLOR_PRIMARY
'   $COLOR_PRIMARY
'
!function $resolve_variable($name, $raiseError = %true() )

  !$value = %get_variable_value( $strip_dollar($name) )

  !if $value == ""
    !if $raiseError == %true()
        !error "MB_UML :: Unable to resolve variable name: $name"
    !endif
  !endif

  !return $value

!endfunction

