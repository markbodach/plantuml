!function $fallback_chain($tokens)

    !$result = ""
    !$i = 0

    !while $i < %size($tokens)
        !if $i > 0
            !$result = $result + " -> "
        !endif
        !$result = $result + $tokens[$i]
        !$i = $i + 1
    !endwhile
    !return $result

!endfunction


!function $resolve_style_color($tokenOrColor, $colorIfToken="")

  !$tokenOrColorIsSpecial = $is_special_style_token($tokenOrColor)
  !$colorIfTokenIsSpecial  = $is_special_style_token($colorIfToken)
  

  'All special style tokens require a color to resolve against
  !if ($tokenOrColorIsSpecial == %true()) && ($colorIfToken == "")
    !assert 0 == 1 : "MB_UML :: SPECIAL.BLANK[" + $tokenOrColor +"] (resolve_style_color) requires a colorIfToken=[" + $colorIfToken + "]"
  !endif

  'All special style tokens require a color to resolve against
  !if ($tokenOrColorIsSpecial == %true()) && ($colorIfTokenIsSpecial == %true()) 
    !assert 0 == 1 : "MB_UML :: SPECIAL.SPECIAL[" + $tokenOrColor +"] (resolve_style_color) and colorIfToken=[" + $colorIfToken + "] can not be tokens"
  !endif

  !if ($tokenOrColor == "") && ($colorIfToken == "")
    !assert 0 == 1 : "MB_UML :: BLANK.BLANK[" + $tokenOrColor +"] (resolve_style_color) requires a tokenOrColor=[" + $tokenOrColor +"] or a colorIfToken=[" + $colorIfToken + "]"
  !endif

  !if ($tokenOrColor == "AUTO")
    !if $colorIfTokenIsSpecial == %true()
        !assert 0 == 1 : "MB_UML :: AUTO (resolve_style_color) cannot resolve special token as colorIfToken=[" + $colorIfToken + "]"
    !endif
    !return $get_semantic_text_color($colorIfToken)
  
  !elseif ($tokenOrColor == "CURRENT")
    !if ($colorIfTokenIsSpecial == %true())
        !assert 0 == 1 : "MB_UML :: CURRENT (resolve_style_color) cannot resolve special token as colorIfToken=[" + $colorIfToken + "]"
    !endif
    !return $resolve_style_color($colorIfToken)

  !elseif (%strpos($tokenOrColor,"DARKEN") == 0)
    !return $darken_color($colorIfToken, $token)

  !elseif (%strpos($tokenOrColor,"LIGHTEN") == 0)
    !return $lighten_color($colorIfToken, $tokenOrColor)
  
  !elseif ($is_literal_color($tokenOrColor))
    !return $tokenOrColor

  !elseif ($ends_with_text($tokenOrColor) == %true())
    !$base = %substr($tokenOrColor, 0, %strlen($tokenOrColor)-5)
    !return $get_semantic_text_color($base)
  !else
    !return $get_semantic_color($tokenOrColor)
  !endif

!endfunction


!function $resolve_style_color_chain($tokenOrColor, $colorIfTokenArray=[])

  !$tokenOrColorIsSpecial = $is_special_style_token($tokenOrColor)

  !if $tokenOrColorIsSpecial == %false()
    !return $resolve_style_color($tokenOrColor)

  !else 
    !$colorIfToken = $first_color_token($colorIfTokenArray)
    
    !return $resolve_style_color($tokenOrColor, $colorIfToken)
  !endif
!endfunction