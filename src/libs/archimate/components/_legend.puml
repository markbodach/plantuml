
!procedure Archimate_Register_Legend_Layer($layer)

    !$layer = %upper($layer)
    !if ($token_registered($layer,$ARCHIMATE_LEGEND_EXCLUDE) == %false())
        Register_Lib_Object($layer,$REGISTRY_ARCHIMATE_LEGEND_LAYERS)
    !endif

!endprocedure


!function $Archimate_Legend_Layer_Used($layer)
    !return $object_registered($layer,$REGISTRY_ARCHIMATE_LEGEND_LAYERS)
!endfunction


!procedure Archimate_Legend_Row($layer,$color,$label)

    !if ($Archimate_Legend_Layer_Used($layer))
        Legend_Row("<back:" + $color + ">       </back>", $label )
    !endif

!endprocedure

!procedure Archimate_Legend_Layer($layer)

    !$layer = %upper($layer)

    !if ($Archimate_Legend_Layer_Used($layer))
        !$colorVar = "ARCH_" + $layer + "_FILLCOLOR"
        !$labelKey = "LAYER_" + $layer
        Legend_Row( "<back:" + $resolve_variable($colorVar) + ">      </back>", $get_word($labelKey) )
    !endif

!endprocedure


!procedure Archimate_Legend()

    Legend_Begin( $get_word("LEGEND_TITLE_ARCHIMATE"), $get_word("LEGEND_COLUMN_SAMPLE"), $get_word("LEGEND_COLUMN_MEANING") )
    For_Each_Token_Value( "Archimate_Legend_Layer", $ARCHIMATE_LEGEND_ORDER )
    Legend_End()

!endprocedure

!procedure Clear_Archimate_Legend()

    Registry_Set( $REGISTRY_ARCHIMATE_LEGEND_LAYERS, $REGISTRY_DEL )

!endprocedure


