!unquoted procedure ArchActor( $alias, $label, $sprite, $layer )

    !if ($sprite == "sprite_arch_business_actor")

        actor "$label" as $alias <<$sprite_arch_business_actor>> <<%lower($layer)>>

    !else

        actor "$label" as $alias <<%lower($layer)>>

    !endif

!endprocedure


