
!unquoted procedure ArchElement( $alias, $label, $stereotype="", $shape="", $layer="" )

    Archimate_Build_Context( $label, $stereotype, $shape, $layer )

    !if ($ARCH_CTX_SHAPE == "actor")

        ArchActor( $alias, $ARCH_CTX_LABEL,$ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "queue")

        ArchQueue( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "frame")

        ArchFrame( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "component")

        ArchComponent( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "node")

        ArchNode( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "file")

        ArchFile( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "cloud")

        ArchCloud( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "usecase")

        ArchUseCase( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "package")

        ArchPackage( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "process")

        ArchProcess( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "folder")

        ArchFolder( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !elseif ($ARCH_CTX_SHAPE == "circle")

        ArchCircle( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !else

        ArchRectangle( $alias, $ARCH_CTX_LABEL, $ARCH_CTX_SPRITE, $ARCH_CTX_LAYER )

    !endif

!endprocedure

