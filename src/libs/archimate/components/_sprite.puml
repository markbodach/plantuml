!function $archimate_sprite_key_from_entity($entity)
    !$key = "sprite_arch_" + $replace(%lower($entity),"-","_")
    !if (%variable_exists("$" + $key))
        !return $key
    !endif
    !return ""
!endfunction

!function $archimate_sprite_key($entity)
    !$resolved = $archimate_sprite_entity($entity)
    !$key = $archimate_sprite_key_from_entity($resolved)
    !if ($key != "")
        !return $key
    !endif
    !$resolved = $archimate_default_sprite_entity($entity)
    !$key = $archimate_sprite_key_from_entity($resolved)
    !return $key
!endfunction




!function $archimate_layer_from_entity($entity)
    !$s = %lower($entity)
    !$pos = %strpos($s,"-")

    !if ($pos >= 0)
        !return %upper(%substr($s,0,$pos))
    !endif

    !if ($s == "business")
        !return "BUSINESS"

    !elseif ($s == "application")
        !return "APPLICATION"

    !elseif ($s == "technology")
        !return "TECHNOLOGY"

    !elseif ($s == "strategy")
        !return "STRATEGY"

    !elseif ($s == "motivation")
        !return "MOTIVATION"

    !elseif ($s == "implementation")
        !return "IMPLEMENTATION"

    !endif

    !return "OTHER"

!endfunction


!function $archimate_entity($entity)

    !return %lower($entity)

!endfunction


!function $archimate_type($stereotype)

    !$s = %lower($stereotype)

    !$pos = %strpos($s, "-")

    !if ($pos >= 0)
        !return %substr($s, $pos + 1)
    !endif

    ' Layer-only values
    !if ($s == "business")
        !return ""
    !elseif ($s == "application")
        !return ""
    !elseif ($s == "technology")
        !return ""
    !elseif ($s == "motivation")
        !return ""
    !elseif ($s == "strategy")
        !return ""
    !elseif ($s == "implementation")
        !return ""
    !endif

    !return $s

!endfunction

!function $archimate_sprite_base_entity($sprite)

    !$entity = %substr($sprite,12)
    !$entity = $replace($entity,"_","-")

    !return $archimate_base_entity($entity)

!endfunction

