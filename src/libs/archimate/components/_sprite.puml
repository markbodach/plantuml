
!function $archimate_sprite($stereotype)

    !$s = %lower($stereotype)
    !$pos = %strpos($s,"-")
    !if ($pos >= 0)
        !return "sprite_arch_" + $replace($s,"-","_")
    !endif
    !return ""
!endfunction



!function $archimate_layer_from_stereotype($stereotype)
    !$s = %lower($stereotype)
    !$pos = %strpos($s,"-")

    !if ($pos >= 0)
        !return %upper(%substr($s,0,$pos))
    !endif

    !if ($s == "business")
        !return "BUSINESS"

    !elseif ($s == "application")
        !return "APPLICATION"

    !elseif ($s == "technology")
        !return "TECHNOLOGY"

    !elseif ($s == "strategy")
        !return "STRATEGY"

    !elseif ($s == "motivation")
        !return "MOTIVATION"

    !elseif ($s == "implementation")
        !return "IMPLEMENTATION"

    !endif

    !return "OTHER"

!endfunction



!function $archimate_type($stereotype)

    !$s = %lower($stereotype)

    !$pos = %strpos($s, "-")

    !if ($pos >= 0)
        !return %substr($s, $pos + 1)
    !endif

    ' Layer-only values
    !if ($s == "business")
        !return ""
    !elseif ($s == "application")
        !return ""
    !elseif ($s == "technology")
        !return ""
    !elseif ($s == "motivation")
        !return ""
    !elseif ($s == "strategy")
        !return ""
    !elseif ($s == "implementation")
        !return ""
    !endif

    !return $s

!endfunction



!function $archimate_shape($stereotype)

    !$s = %lower($stereotype)

    !$pos = %strpos($s, "-")

    !if ($pos >= 0)
        !$s = %substr($s, $pos + 1)
    !endif

    !if ($s == "actor")
        !return "actor"

    !elseif ($s == "role")
        !return "queue"

    !elseif ($s == "product")
        !return "frame"

    !elseif ($s == "component")
        !return "component"

    !elseif ($s == "node")
        !return "node"

    !elseif ($s == "device")
        !return "node"

    !elseif ($s == "systemsoftware")
        !return "node"

    !elseif ($s == "collaboration")
        !return "node"

    !elseif ($s == "equipment")
        !return "node"

    !elseif ($s == "facility")
        !return "node"

    !elseif ($s == "artifact")
        !return "file"

    !elseif ($s == "communicationnetwork")
        !return "cloud"

    !elseif ($s == "distributionnetwork")
        !return "cloud"

    !elseif ($s == "meaning")
        !return "cloud"

    !elseif ($s == "value")
        !return "usecase"

    !elseif ($s == "workpackage")
        !return "package"

    !elseif ($s == "deliverable")
        !return "file"

    !elseif ($s == "plateau")
        !return "package"

    !elseif ($s == "grouping")
        !return "folder"

    !elseif ($s == "group")
        !return "folder"

    !elseif ($s == "and")
        !return "circle"

    !elseif ($s == "or")
        !return "circle"

    !elseif ($s == "valuestream")
        !return "process"

    !endif

    !return "rectangle"

!endfunction

