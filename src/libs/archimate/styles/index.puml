!include _fonts.puml
!include _colors.puml
!include _corner.puml
!include _width.puml
!include _element.puml


!procedure Preload_Lib_Styles_Archimate()

    !if ($ARCHIMATE_LIB_ENABLED)
        Preload_Lib_Styles_Archimate_Colors()
        Preload_Lib_Styles_Archimate_Fonts()
        Preload_Lib_Styles_Archimate_Corners()
        Preload_Lib_Styles_Archimate_Widths()

    !endif

!endprocedure 


!procedure Load_Lib_Styles_Archimate()
    !if ($ARCHIMATE_LIB_ENABLED)

        Write_Lib_Style_Archimate_Element()
        rectangle "Load_Lib_Styles_Archimate"
    !endif

!endprocedure 