

!procedure Preload_Lib_Styles_Archimate_Colors()

    '=====================================================
    ' Layer Colors
    '=====================================================

    !global $ARCH_STRATEGY_FILLCOLOR ?= $resolve_literal_color($COLOR_STRATEGY)
    !global $ARCH_BUSINESS_FILLCOLOR ?= $resolve_literal_color($COLOR_BUSINESS)
    !global $ARCH_APPLICATION_FILLCOLOR ?= $resolve_literal_color($COLOR_APPLICATION)
    !global $ARCH_TECHNOLOGY_FILLCOLOR ?= $resolve_literal_color($COLOR_TECHNOLOGY)

    ' ArchiMate physical layer
    !global $ARCH_PHYSICAL_FILLCOLOR ?= $resolve_literal_color($COLOR_PHYSICAL)

    !global $ARCH_MOTIVATION_FILLCOLOR ?= $resolve_literal_color($COLOR_MOTIVATION)

    !global $ARCH_IMPLEMENTATION_FILLCOLOR ?= $resolve_literal_color($COLOR_IMPLEMENTATION)

    ' Other layer
    !global $ARCH_OTHER_FILLCOLOR ?= $resolve_literal_color($COLOR_EMPHASIS_LIGHT)

    '=====================================================
    ' Junction Colors
    '=====================================================

    !global $ARCH_JUNCTIONOR_FILLCOLOR ?= $resolve_literal_color($COLOR_BODY)
    !global $ARCH_JUNCTIONAND_FILLCOLOR ?= $resolve_literal_color($COLOR_TEXT)

    '=====================================================
    ' Containers
    '=====================================================

    !global $ARCH_GROUP_FILLCOLOR ?= $resolve_literal_color($COLOR_DISABLED_LIGHT)

    !global $ARCH_FOLDER_LINECOLOR ?= $resolve_literal_color($COLOR_BORDER)

    '=====================================================
    ' Relationships
    '=====================================================

    !global $ARCH_RELATIONSHIP_LINECOLOR ?= $resolve_literal_color($COLOR_LINE)
    !global $ARCH_RELATIONSHIP_FONTCOLOR ?= $resolve_literal_color($COLOR_TEXT)

!endprocedure
