!include _fonts.puml
!include _colors.puml

!include _mapped_colors.puml

!include _corners.puml
!include _widths.puml
!include _element.puml


!procedure Load_Lib_Theme_Archimate()

    !if ($ARCHIMATE_LIB_ENABLED == %true() )
        
        Load_Lib_Theme_Archimate_Colors()
        Load_Lib_Theme_Archimate_Mapped_Colors()
        Breakpoint_If( "ARCH_MOTIVATION_VALUE", %true(), "AFTER_MAPPED=[" + $ARCH_MOTIVATION_FILLCOLOR + "]" )

        Load_Lib_Theme_Archimate_Fonts()
        Load_Lib_Theme_Archimate_Corners()
        Load_Lib_Theme_Archimate_Widths()

    !endif

!endprocedure 


!procedure Load_Lib_Styles_Archimate()
    !if ($ARCHIMATE_LIB_ENABLED == %true() )

        Write_Lib_Style_Archimate_Element()
    !endif

!endprocedure 